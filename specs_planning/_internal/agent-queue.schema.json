{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Queue",
  "type": "object",
  "required": ["version", "lastUpdated", "config", "queue"],
  "properties": {
    "version": {"type": "string"},
    "lastUpdated": {"type": "string", "format": "date-time"},
    "config": {
      "type": "object",
      "properties": {
        "maxRetries": {"type": "integer"},
        "autoHealOnFailure": {"type": "boolean"},
        "lockTimeoutMinutes": {"type": "integer"},
        "autoInjectContext": {"type": "boolean", "description": "Auto-run task-context-builder on queue changes"}
      }
    },
    "queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "module", "stage", "priority"],
        "properties": {
          "id": {"type": "string"},
          "feature": {"type": "string"},
          "module": {"type": "string"},
          "intent": {"type": "string"},
          "stage": {"type": "string", "enum": ["pending_requirements", "requirements", "pending_planning", "planning", "pending_generation", "generation", "testing", "completed", "pending_healing", "healing", "fixme"]},
          "priority": {"type": "string", "enum": ["high", "medium", "low"]},
          "lockedBy": {"type": ["string", "null"]},
          "lockedAt": {"type": ["string", "null"]},
          "artifacts": {
            "type": "object",
            "properties": {
              "testCaseFile": {"type": ["string", "null"]},
              "testPlanFile": {"type": ["string", "null"]},
              "specFiles": {"type": "array", "items": {"type": "string"}},
              "csvExport": {"type": ["string", "null"], "description": "Auto-generated CSV export path"}
            }
          },
          "uiTestingChecklist": {
            "type": "object",
            "description": "Mandatory UI testing checklist - all must be true before stage transition",
            "properties": {
              "fieldDiscovery": {"type": "boolean", "description": "All fields identified via browser_snapshot"},
              "dependencyMapping": {"type": "boolean", "description": "Disabled field triggers documented"},
              "boundaryTesting": {"type": "boolean", "description": "Min/max/edge values tested"},
              "errorVerification": {"type": "boolean", "description": "All error messages triggered"},
              "saveReloadCycles": {"type": "boolean", "description": "Persistence verified for all fields"},
              "crossFieldValidation": {"type": "boolean", "description": "Date relationships, conditional logic"},
              "errorRecovery": {"type": "boolean", "description": "Fix error and save succeeds flows"},
              "dialogSymmetry": {"type": "boolean", "description": "Every dialog has open+action AND open+cancel TCs"},
              "selectorReconciliation": {"type": "boolean", "description": "All TC-referenced selectors exist in index.ts"},
              "explorationCleanup": {"type": "boolean", "description": "All fields restored after deep exploration"},
              "completedAt": {"type": ["string", "null"], "description": "ISO timestamp when all checks pass"}
            }
          },
          "injectedContext": {
            "type": "object",
            "description": "Auto-generated context injection for the agent working on this task",
            "properties": {
              "generatedAt": {"type": "string", "format": "date-time"},
              "targetAgent": {"type": "string", "enum": ["Requirements", "Planner", "Generator", "Healer", "Audit"]},
              "mistakes": {
                "type": "array",
                "description": "Subset of agent-specific NEVER DO rules (limited by MISTAKE_DISPLAY_LIMIT). Full set available via mistakesRef.",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {"type": "string"},
                    "never": {"type": "string"},
                    "correct": {"type": "string"}
                  }
                }
              },
              "mistakesRef": {"type": "string", "description": "Reference to full mistakes registry when inline rules are truncated"},
              "learnings": {
                "type": "array",
                "description": "Cross-agent learning patterns — check before retrying failed actions",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {"type": "string"},
                    "category": {"type": "string", "enum": ["SELECTOR", "TIMING", "LOGIC", "DATA", "SCOPE", "FORMAT", "NAVIGATION", "AUTH"]},
                    "trigger": {"type": "string"},
                    "rootCause": {"type": "string"},
                    "solution": {"type": "string"},
                    "agent": {"type": "string"},
                    "date": {"type": "string"}
                  }
                }
              },
              "learningsRef": {"type": "string", "description": "Reference to full learnings registry file"},
              "moduleContext": {"type": "string"},
              "moduleContextRef": {"type": "string", "description": "File + section reference for module context"},
              "recentDefects": {"type": "array", "items": {"type": "string"}},
              "criticalReminders": {"type": "array", "items": {"type": "string"}},
              "selfAuditQuestions": {"type": "array", "items": {"type": "string"}, "description": "Agent-specific verification questions for self-audit"}
            }
          },
          "history": {"type": "array", "items": {"type": "object"}},
          "selfAuditPassed": {"type": "boolean", "description": "Set to true after agent completes R23 3-layer self-audit"},
          "generatorRunCount": {"type": "integer", "minimum": 0, "description": "R10 enforcement: number of Generator test run invocations. Blocked at 2 without retry-justification."},
          "fixScope": {
            "type": "object",
            "description": "Failure scope for Generator fix mode — populated from failure-summary.json",
            "properties": {
              "failedTestIds": {"type": "array", "items": {"type": "string"}},
              "failureSummaryPath": {"type": ["string", "null"]},
              "description": {"type": "string"},
              "failureCategories": {"type": "object", "description": "Category counts e.g. { AUTH: 2, SELECTOR: 1 }", "additionalProperties": {"type": "integer"}}
            }
          },
          "automatableCount": {"type": "integer", "minimum": 0, "description": "TCs with Automatable: Yes"},
          "totalTcCount": {"type": "integer", "minimum": 0, "description": "All TCs including No/Blocked"},
          "skippedTcIds": {"type": "array", "items": {"type": "string"}, "description": "TC IDs marked Automatable: No or Blocked"},
          "removedCoverage": {"type": "array", "items": {"type": "string"}, "description": "TC IDs removed from spec by agent (missing-coverage) — permanent"},
          "blocked": {"type": "boolean", "description": "True = item blocked from advancing until audit clears it"},
          "blockedBy": {"type": "string", "description": "Agent/reason that triggered the block (e.g. audit, healer)"},
          "blockedReason": {"type": "string", "description": "Human-readable explanation of why blocked"},
          "auditCleared": {"type": "boolean", "description": "True = audit agent has reviewed and cleared the block"},
          "completionContext": {
            "type": "object",
            "description": "Pipeline handoff context written by post-complete gates for the next agent",
            "properties": {
              "phaseCompleted": {"type": "string", "description": "Stage that just completed (e.g. generation, healing, audit)"},
              "artifactsModified": {"type": "array", "items": {"type": "string"}, "description": "File paths modified during this phase"},
              "testsPassed": {"type": "boolean", "description": "Whether tests passed"},
              "defectsFound": {"type": "integer", "minimum": 0, "description": "Count of defects found"},
              "recommendedNextStage": {"type": "string", "description": "Suggested next stage based on outcome"}
            }
          }
        }
      }
    },
    "completedLog": {"type": "array"}
  }
}
