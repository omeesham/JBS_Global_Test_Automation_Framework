# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains production environment settings.
# ⚠️ ALL SECRETS MUST BE SET IN CI/CD PLATFORM SECRETS ⚠️
# Never commit actual production secrets to Git!
# =============================================================================

# Environment
CI_ENV=production

# Application URLs (Navigator Cloud)
BASE_URL=https://cloudapps-e2e.encoreglobal.com/navigator/
HOME_URL=https://cloudapps-e2e.encoreglobal.com/navigator/locations/1604/home
API_BASE_URL=https://cloudapps-e2e.encoreglobal.com/api/v1

# Office Separation (execution vs MCP exploration)
EXECUTION_OFFICE_NO=1604
EXPLORATION_OFFICE_NO=0220

# Timeouts (conservative for production stability)
TIMEOUT_DEFAULT=30000
TIMEOUT_NAVIGATION=60000
TIMEOUT_ACTION=15000
TIMEOUT_ASSERTION=5000

# Database (production database - ⚠️ SET IN CI SECRETS)
DB_HOST=prod-db.example.com
DB_PORT=5432
DB_USER=***SET_IN_CI_SECRETS***
DB_PASSWORD=***SET_IN_CI_SECRETS***
DB_NAME=production_db
DB_TYPE=postgresql

# AWS S3 (production bucket - ⚠️ SET IN CI SECRETS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=***SET_IN_CI_SECRETS***
AWS_SECRET_ACCESS_KEY=***SET_IN_CI_SECRETS***
S3_BUCKET=prod-test-data

# Test Credentials (Navigator Cloud - ⚠️ USE VAULT OR CI SECRETS)
NAVIGATOR_USERNAME=***USE_VAULT***
NAVIGATOR_PASSWORD=***USE_VAULT***
NAVIGATOR_MFA_SECRET=***USE_VAULT***

# Feature Flags (minimal artifacts for production)
ENABLE_TRACING=false
ENABLE_VIDEO=false
ENABLE_SCREENSHOTS=false
ENABLE_API_MOCKING=false

# Retry Configuration (aggressive retries for production stability)
RETRY_COUNT=3
MAX_FAILURES=5

# Browser Configuration (headless for CI)
DEFAULT_BROWSER=chrome
HEADLESS=true

# Logging (warn level for production - less noise)
LOG_LEVEL=warn
LOG_FILE=logs/prod-execution.log

# OpenAI (disable for production unless explicitly needed)
# OPENAI_API_KEY=***SET_IN_CI_SECRETS***
ENABLE_OPENAI_SELF_HEALING=false

# AI Subscription Management (Plan 41)
WEBSITE_BACKEND_URL=***SET_IN_CI_SECRETS***
ENCRYPTION_SECRET=***SET_IN_CI_SECRETS***
WORKER_TYPE=cli_dedicated
# WORKER_CLIENT_ID=***SET_IN_CI_SECRETS***

# CI detection
CI=true
