# Local Environment Overrides
# This file is gitignored - safe for personal credentials

# Navigator Cloud
BASE_URL=https://cloudapps-e2e.encoreglobal.com/navigator/
HOME_URL=https://cloudapps-e2e.encoreglobal.com/navigator/locations/1604/home
API_BASE_URL=https://cloudapps-e2e.encoreglobal.com/navigator/api/v1

# Vault passphrase (required — decrypts .vault.enc for test credentials)
# Put your real passphrase here — this file is gitignored
VAULT_PASSPHRASE=Qa@12345678!!

# Browser Configuration
DEFAULT_BROWSER=chrome
HEADLESS=false

# Timeouts
TIMEOUT_DEFAULT=60000
TIMEOUT_NAVIGATION=90000
TIMEOUT_ACTION=30000
TIMEOUT_ASSERTION=10000

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/dev-execution.log

# Feature Flags
ENABLE_TRACING=true
ENABLE_VIDEO=true
ENABLE_SCREENSHOTS=true
RETRY_COUNT=0

# Encore Server (Fastify backend + worker)
DATABASE_URL=postgresql://postgres:admin@localhost:5432/postgres
WORKER_SECRET=dev-secret
CORS_ORIGIN=http://localhost:5173
PORT=3100
HOST=0.0.0.0
NODE_ENV=development
AUTO_MIGRATE=true
BACKEND_URL=http://localhost:3100
WORKER_ID=local-worker-1
