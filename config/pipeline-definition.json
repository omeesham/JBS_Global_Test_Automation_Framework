{
  "version": "1.1",
  "defaults": {
    "model": "sonnet",
    "maxTurnsPerStage": 0,
    "budgetPerRunUsd": 0,
    "budgetPerStageUsd": 0,
    "workerPollIntervalMs": 5000,
    "workerHeartbeatIntervalMs": 30000,
    "cliPath": "claude",
    "cliOutputFormat": "json",
    "agentRunner": "cli",
    "autoInvoke": true,
    "note_budgets": "0 = unlimited. Only the user can stop an agent (like stopping Claude mid-chat)."
  },
  "models": {
    "available": [
      "haiku",
      "sonnet",
      "opus"
    ],
    "costPerMTokenInput": {
      "haiku": 0.25,
      "sonnet": 3,
      "opus": 15
    },
    "costPerMTokenOutput": {
      "haiku": 1.25,
      "sonnet": 15,
      "opus": 75
    }
  },
  "stages": [
    {
      "id": "requirements",
      "name": "Requirements Intake",
      "agent": "requirements",
      "agentFile": ".claude/agents/REQUIREMENTS.md",
      "model": "sonnet",
      "effort": "high",
      "enabled": true,
      "maxTurns": 0,
      "budgetCap": 0,
      "retries": 0,
      "timeoutSeconds": 0,
      "next": {
        "success": "planning"
      },
      "browserTool": "cli",
      "cliConfig": {
        "sessionName": "e2e"
      },
      "approvalMode": "auto",
      "preRunGate": "requirements-pre-run.ts",
      "postCompleteGate": "requirements-post-complete.ts",
      "description": "Explores target URL, captures UI structure and requirements"
    },
    {
      "id": "planning",
      "name": "Test Case Planning",
      "agent": "planner",
      "agentFile": ".claude/agents/PLANNER.md",
      "model": "sonnet",
      "effort": "high",
      "enabled": true,
      "maxTurns": 0,
      "budgetCap": 0,
      "retries": 0,
      "timeoutSeconds": 0,
      "next": {
        "success": "generation"
      },
      "browserTool": "cli",
      "cliConfig": {
        "sessionName": "e2e"
      },
      "approvalMode": "auto",
      "preRunGate": "planner-pre-run.ts",
      "postCompleteGate": "planner-post-complete.ts",
      "description": "Creates detailed test cases from requirements"
    },
    {
      "id": "generation",
      "name": "Spec Generation",
      "agent": "generator",
      "agentFile": ".claude/agents/GENERATOR.md",
      "model": "sonnet",
      "effort": "high",
      "enabled": true,
      "maxTurns": 0,
      "budgetCap": 0,
      "retries": 0,
      "timeoutSeconds": 0,
      "next": {
        "success": "audit"
      },
      "routing": {
        "condition": "testResults",
        "rules": [
          {
            "when": "failedCount == 0",
            "then": "audit"
          },
          {
            "when": "failureClass in selector_not_found,selector_ambiguous,missing_selectors",
            "then": "planning"
          }
        ],
        "note": "Generator runs its fix loop until tests pass. No routing to healer. Selector issues go back to planner."
      },
      "browserTool": "cli",
      "cliConfig": {
        "sessionName": "e2e"
      },
      "approvalMode": "auto",
      "preRunGate": "generator-pre-run.ts",
      "postCompleteGate": "generator-post-complete.ts",
      "description": "Generates Playwright spec files from test cases"
    },
    {
      "id": "healing",
      "name": "Test Healing",
      "agent": "healer",
      "agentFile": ".claude/agents/HEALER.md",
      "model": "sonnet",
      "effort": "high",
      "enabled": true,
      "pipelineStage": false,
      "standalone": true,
      "maxTurns": 0,
      "budgetCap": 0,
      "retries": 0,
      "timeoutSeconds": 0,
      "next": {},
      "browserTool": "both",
      "cliConfig": {
        "sessionName": "e2e"
      },
      "approvalMode": "auto",
      "preRunGate": "healer-pre-run.ts",
      "postCompleteGate": "healer-post-complete.ts",
      "description": "Post-production support bot. Fixes previously-working tests that broke due to app changes. NOT part of normal pipeline — invoked manually by user."
    },
    {
      "id": "audit",
      "name": "Quality Audit",
      "agent": "audit",
      "agentFile": ".claude/agents/AUDIT.md",
      "model": "sonnet",
      "effort": "high",
      "enabled": true,
      "maxTurns": 0,
      "budgetCap": 0,
      "retries": 0,
      "timeoutSeconds": 0,
      "next": {
        "pass": "completed",
        "critical": "fixme"
      },
      "browserTool": "cli",
      "cliConfig": {
        "sessionName": "e2e"
      },
      "approvalMode": "auto",
      "preRunGate": "audit-pre-run.ts",
      "postCompleteGate": "audit-post-complete.ts",
      "description": "Reviews all artifacts for quality and completeness"
    }
  ],
  "terminalStates": [
    "completed",
    "fixme",
    "cancelled"
  ],
  "convergenceGuards": {
    "enabled": false,
    "note": "Disabled — no turn/budget limits. User controls agent lifecycle.",
    "sameFindings": {
      "enabled": false,
      "action": "fixme"
    },
    "notDecreasing": {
      "enabled": false,
      "windowSize": 2,
      "action": "fixme"
    },
    "maxIterations": {
      "enabled": false,
      "limit": 0,
      "action": "fixme"
    },
    "budgetExhausted": {
      "enabled": false,
      "action": "fixme"
    }
  }
}
