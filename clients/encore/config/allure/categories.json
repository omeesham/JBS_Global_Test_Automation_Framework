[
  {
    "name": "Product Defects",
    "description": "Assertion failures indicating potential application bugs",
    "matchedStatuses": ["failed"],
    "messageRegex": ".*expect\\(.*\\)\\.to.*|.*Expected.*Received.*|.*toBe|.*toEqual|.*toContain|.*toHaveText|.*toBeVisible|.*toHaveValue.*"
  },
  {
    "name": "Timeout Errors",
    "description": "Operations that exceeded their configured timeout",
    "matchedStatuses": ["failed", "broken"],
    "messageRegex": ".*TimeoutError.*|.*Timeout.*exceeded.*|.*waiting for.*"
  },
  {
    "name": "Selector / Element Issues",
    "description": "Elements not found or not interactable in the DOM",
    "matchedStatuses": ["failed", "broken"],
    "messageRegex": ".*locator\\..*|.*element.*not.*found.*|.*not.*visible.*|.*not.*attached.*|.*strict mode violation.*"
  },
  {
    "name": "Authentication Failures",
    "description": "SSO / Microsoft login / session failures",
    "matchedStatuses": ["failed", "broken"],
    "messageRegex": ".*SSO.*|.*login.*|.*auth.*|.*Microsoft.*|.*sign.in.*|.*session.*expired.*"
  },
  {
    "name": "Network Errors",
    "description": "HTTP errors, connection failures, or API issues",
    "matchedStatuses": ["failed", "broken"],
    "messageRegex": ".*ERR_CONNECTION.*|.*net::.*|.*ECONNREFUSED.*|.*status.*[45]\\d{2}.*|.*fetch.*failed.*"
  },
  {
    "name": "Test Infrastructure",
    "description": "Fixture setup failures, configuration issues, or framework errors",
    "matchedStatuses": ["failed", "broken"],
    "messageRegex": ".*fixture.*|.*setup.*failed.*|.*beforeAll.*|.*beforeEach.*|.*Worker.*"
  }
]
