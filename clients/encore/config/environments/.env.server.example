# Encore Backend Server Environment
# Copy this file to .env.server and fill in values
# cp .env.server.example .env.server

# PostgreSQL connection string (matches docker-compose.yml defaults)
# Standard PostgreSQL: postgresql://user:password@localhost:5432/encore_db
# Neon: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/encore_db?sslmode=require
DATABASE_URL=postgresql://postgres:admin@localhost:5432/postgres

# Shared secret for worker <-> backend auth
WORKER_SECRET=dev-secret

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Server config
PORT=3100
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Auto-run schema.sql on startup (set false if managing migrations manually)
AUTO_MIGRATE=true

# Worker config (for pipeline/worker/index.ts)
BACKEND_URL=http://localhost:3100
WEBSITE_BACKEND_URL=http://localhost:3001
WORKER_ID=local-worker-1
WORKER_TYPE=cli_dedicated
# WORKER_CLIENT_ID=  # Set for dedicated CLI workers

# AI Provider encryption (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ENCRYPTION_SECRET=  # 64-char hex string, required for production
