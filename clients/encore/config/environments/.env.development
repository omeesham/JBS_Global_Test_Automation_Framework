# =============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains development environment settings.
# For local overrides, create .env.development.local (not tracked by Git)
# =============================================================================

# Environment
CI_ENV=development

# Multi-tenant: active client tree under clients/<id>/ (SP-MT-01).
ACTIVE_CLIENT=encore

# Application URLs (Navigator Cloud)
BASE_URL=https://cloudapps-e2e.encoreglobal.com/navigator/
HOME_URL=https://cloudapps-e2e.encoreglobal.com/navigator/locations/1604/home
API_BASE_URL=https://cloudapps-e2e.encoreglobal.com/navigator/api/v1

# Timeouts (more generous for local debugging)
TIMEOUT_DEFAULT=60000
TIMEOUT_NAVIGATION=90000
TIMEOUT_ACTION=30000
TIMEOUT_ASSERTION=10000

# Database (local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=dev_user
DB_PASSWORD=dev_password
DB_NAME=dev_database
DB_TYPE=postgresql

# AWS S3 (use local credentials or leave empty for stub mode)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
S3_BUCKET=dev-test-data

# Test Credentials (Navigator Cloud - Microsoft SSO + MFA)
NAVIGATOR_USERNAME=v-rutvik.khosariya@psav.com
NAVIGATOR_PASSWORD=Qa@12345678!!
NAVIGATOR_MFA_SECRET=CYFRPMNXGR75FQQF

# Feature Flags (enable all features for local testing)
ENABLE_TRACING=true
ENABLE_VIDEO=true
ENABLE_SCREENSHOTS=true
ENABLE_API_MOCKING=false

# Retry Configuration (no retries for faster feedback)
RETRY_COUNT=0
MAX_FAILURES=999

# Browser Configuration
DEFAULT_BROWSER=chrome
HEADLESS=false

# Logging (verbose for debugging)
LOG_LEVEL=debug
LOG_FILE=logs/dev-execution.log

# OpenAI (optional for local development)
# OPENAI_API_KEY=
ENABLE_OPENAI_SELF_HEALING=false

# AI Subscription Management (Plan 41)
WEBSITE_BACKEND_URL=http://localhost:3001
# ENCRYPTION_SECRET=  # Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_TYPE=cli_dedicated
# WORKER_CLIENT_ID=
