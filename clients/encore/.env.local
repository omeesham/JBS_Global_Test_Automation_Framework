# Local dev config — gitignored. Loaded by default for local/agent spec runs.
# Targets the same e2e server as CI; carries personal creds.

CI_ENV=local
ACTIVE_CLIENT=encore

# Navigator Cloud (same e2e server as CI)
BASE_URL=https://cloudapps-e2e.encoreglobal.com/navigator/
HOME_URL=https://cloudapps-e2e.encoreglobal.com/navigator/locations/1604/home
API_BASE_URL=https://cloudapps-e2e.encoreglobal.com/navigator/api/v1

# Test credentials (Microsoft SSO automation user)
NAVIGATOR_USERNAME=s-prd-clickauto@psav.com
NAVIGATOR_PASSWORD=6p8zA`96F>!0

# Failure artifacts
ENABLE_TRACING=true
ENABLE_VIDEO=true
ENABLE_SCREENSHOTS=true

# Misc
DEFAULT_BROWSER=chrome
LOG_LEVEL=debug

# Encore Server (Fastify backend + worker) — separate local stack, not used by the Playwright suite
DATABASE_URL=postgresql://postgres:admin@localhost:5432/postgres
WORKER_SECRET=dev-secret
CORS_ORIGIN=http://localhost:5173
PORT=3100
HOST=0.0.0.0
NODE_ENV=development
AUTO_MIGRATE=true
BACKEND_URL=http://localhost:3100
WORKER_ID=local-worker-1
