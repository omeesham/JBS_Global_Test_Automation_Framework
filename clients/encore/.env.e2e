# Encore CI config — CI ONLY. Local/agent runs use .env.local instead
# (enforced by the env-guard in src/setup/global-setup.ts). Both target the same e2e server.
# Credentials are NOT stored here — CI injects NAVIGATOR_*/BASE_URL from its environment / secret store.
# Retries (2) and workers (4) for CI live in playwright.config.ts.

CI_ENV=e2e
ACTIVE_CLIENT=encore

# Target server (Navigator Cloud — Encore's single e2e environment)
BASE_URL=https://cloudapps-e2e.encoreglobal.com/navigator/
HOME_URL=https://cloudapps-e2e.encoreglobal.com/navigator/locations/1604/home
API_BASE_URL=https://cloudapps-e2e.encoreglobal.com/navigator/api/v1

# Failure artifacts
ENABLE_TRACING=true
ENABLE_VIDEO=true
ENABLE_SCREENSHOTS=true

# Misc
DEFAULT_BROWSER=chrome
LOG_LEVEL=info
