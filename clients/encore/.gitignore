# Per-client .gitignore — Path A deliverable rebuild (PLAN_CLIENT_DELIVERABLE_REBUILD).
# Anything listed here does NOT enter `git archive HEAD clients/encore/`.

# Agent / pipeline artifacts (never ship)
CLAUDE.md
specs_planning/
readable_externals/
docs/read_only_docs/
exports/
.auth/

# Per-developer overrides
config/environments/.env.local
config/environments/.env.*.local
config/environments/.env.server

# Build outputs (regenerated, not in git for non-vendor)
node_modules/
reports/
logs/
*.tsbuildinfo

# Vendored framework EXCEPTION — explicitly tracked
!dist/framework/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Playwright
playwright-report/
playwright/.cache/
test-results/
