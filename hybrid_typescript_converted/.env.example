# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Application URLs
BASE_URL=https://your-app-url.com
HOME_URL=https://your-app-url.com

# Test Credentials
USERNAME_AUTOMATION=test_user
PASSWORD_AUTOMATION=test_password

# MFA/TOTP Secrets (Base32 encoded)
MFA_SECRET=YOUR_BASE32_ENCODED_SECRET_HERE
# User-specific MFA secrets (optional)
# MFA_SECRET_USER1=
# MFA_SECRET_USER2=

# OpenAI Configuration (for self-healing locators)
OPENAI_API_KEY=your-openai-api-key-here
ENABLE_OPENAI_SELF_HEALING=false

# Browser Configuration
DEFAULT_BROWSER=chrome
HEADLESS=false

# Test Configuration
TEST_TIMEOUT=30000
EXPECT_TIMEOUT=5000
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000

# CI/CD
CI=false

# Logging
LOG_LEVEL=info
LOG_FILE=logs/test-execution.log
