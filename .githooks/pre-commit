#!/usr/bin/env bash
# Shared pre-commit gate. Register with:  npm run plans:hooks:install
# (Sets core.hooksPath to .githooks — per-clone setup, not automatic.)

set -e

# --- 1) Keep plans/INDEX.md in sync with plans/pending/ and plans/done/. --------
if git diff --cached --name-only | grep -qE '^plans/(pending|done)/.*\.md$'; then
  echo "[pre-commit] plans changed — regenerating plans/INDEX.md"
  node scripts/plans-reindex.mjs --quiet
  git add plans/INDEX.md
fi

# --- 2) SP-AAE-02: block TC MD edits lacking a fresh field-inventory artifact. ---
# Fires only when a clients/*/specs_planning/test-cases/**/*.md change touches
# the behavioural content (Steps / Expected / Data / Preconditions). Metadata,
# comments, and the MCP_VERIFICATION_LOG pass through.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/specs_planning/test-cases/.+\.md$'; then
  echo "[pre-commit] test-case MD changed — checking paired field-inventory artifact"
  node scripts/check-tc-has-fieldinventory.mjs
fi

# Deny-list: refuse to commit a forbidden pattern marker (any cred-bearing literal).
node scripts/verify-no-forbidden.mjs --staged-diff

# --- 4) Group E (PLAN_FRAMEWORK_LIFECYCLE_NOTES_PILOT_V2 2026-05-21): BUG-1 page-fixture
# collision guard. Fails the commit if any spec destructures the built-in `page` fixture
# alongside a `*Page` page-object fixture. Playwright DI creates a second about:blank
# context for the bare `page`, leading to false-greens / false-fails as documented in
# Phase 0.4 baseline + A-1 fix.
if matches=$(grep -rnE "test\([^)]*async\s*\(\s*\{[^}]*(([a-z][a-zA-Z]*Page[^}]*,\s*page\b)|(\bpage\s*,[^}]*[a-z][a-zA-Z]*Page\b))" clients/encore/tests/ 2>/dev/null); then
  if [ -n "$matches" ]; then
    echo "[pre-commit] BUG-1 page-fixture collision detected — spec destructures bare 'page' alongside a *Page fixture:" >&2
    echo "$matches" >&2
    echo "Fix: drop 'page' from the destructure; use '<pageObjectFixture>.page' for direct page operations." >&2
    echo "See: plans/pending/PLAN_FRAMEWORK_DEFENSES_V2.md (Fix #1a — catches both {page, somePage} and {somePage, page} orderings)" >&2
    exit 1
  fi
fi

# --- 5) ALL-071: spec ↔ MD ↔ XLSX parity (FCC mistake prevention, 2026-05-25;
# CSV→XLSX migration 2026-05-27, Phase B of PLAN_CSV_TO_XLSX_DELIVERABLE_MIGRATION).
# Fires whenever a clients/*/tests/**/*.spec.ts is staged. Runs full-repo parity
# (script does not support --module filter; ~10-30s when specs are staged).
# Graduated from PLAN_AGENT_IDENTITY_REALIGNMENT_AND_FCC_STRUCTURAL_CURE.
# 2026-06-11 (PLAN_ID_NAMING_AUDIT_AND_REMEDIATION): also fires on the workbook
# and on the ID-grammar registry / blocked-reasons — parity now carries the
# semantic guardrails 6/7 which key on those files.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/tests/.*\.spec\.ts$|^clients/[^/]+/testcases/.+\.xlsx$|^export_test_cases/(module-codes|blocked-reasons)\.json$'; then
  echo "[pre-commit] spec file staged → running check:tc-parity (ALL-071)..." >&2
  if ! npm run --silent check:tc-parity; then
    echo "[pre-commit] HALT: ALL-071 parity gap. Fix MD/test-plan/XLSX before commit." >&2
    echo "         Inspect: npm run check:tc-parity" >&2
    echo "         Auto-rebuild XLSX: npm run xlsx:build (regenerates the deliverable from MD)" >&2
    exit 1
  fi
fi

# --- 5a) Workbook content-freshness + reproducibility gate (scripts/xlsx-freshness.ts).
# Replaces the prior MTIME check, which only watched test-case-MD timestamps and was
# blind to spec changes, builder changes, and "workbook committed but its builder left
# uncommitted" — it missed every real drift incident. The new gate rebuilds the workbook
# from source and diffs it against the committed copy (Check A) and verifies the workbook's
# generators are committed (Check B). Fires whenever ANY workbook input is staged: a spec,
# a test-case MD, the workbook itself, the builder, or blocked-reasons.json.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/tests/.*\.spec\.ts$|^clients/[^/]+/specs_planning/test-cases/.+\.md$|^clients/[^/]+/testcases/.+\.xlsx$|^export_test_cases/.+\.(ts|json)$'; then
  echo "[pre-commit] workbook input staged → running xlsx freshness gate (rebuild + diff)..." >&2
  if ! npm run --silent xlsx:freshness; then
    echo "[pre-commit] HALT: the deliverable workbook is stale or was built from uncommitted generators." >&2
    echo "         Fix: npm run xlsx:build, then stage the rebuilt workbook AND its generator change(s)." >&2
    exit 1
  fi
fi

# --- 5b) PLAN_CSV_TO_XLSX_DELIVERABLE_MIGRATION Phase D: vocab-leak gate.
# Fires when the XLSX workbook is staged OR when any test-case MD is staged.
# Runs xlsx-vocab-lint against the deliverable workbook to refuse internal/agent
# vocab (data-testid, BUG-LI-NNN, spec helpers, backend symbols, MCP-N verified
# dates, NM-NNN tickets, bare YYYY-MM-DD audit markers) in the shipped TC content.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '(^clients/[^/]+/testcases/.+\.xlsx$|^clients/[^/]+/specs_planning/test-cases/.+\.md$)'; then
  echo "[pre-commit] TC MD or XLSX staged → running xlsx vocab lint (Phase D gate)..." >&2
  if ! node scripts/xlsx-vocab-lint.mjs; then
    echo "[pre-commit] HALT: client-deliverable workbook contains internal/agent vocab." >&2
    echo "         Fix: strip from source MDs under clients/encore/specs_planning/test-cases/setup/," >&2
    echo "         then 'npm run xlsx:build' and restage the workbook." >&2
    exit 1
  fi
fi

# --- 5c) ALL-092: vacuous grid/list-loop guard (warn-only).
# Fires whenever a clients/*/tests/**/*.spec.ts is staged. Flags any
# `for (… of getRows…){ … expect(…) … }` loop with no prior non-zero-count guard
# in the same test block — the pattern that let TC-CPR-STR-013 pass vacuously on an
# empty grid (see scripts/check-vacuous-grid-assertions.mjs header). WARN-ONLY for
# now (the script exits 0 by default); ratchet to --enforce or --baseline once the
# suite is confirmed clean (mirrors the C6 off→announce→deny measured rollout).
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/tests/.*\.spec\.ts$'; then
  echo "[pre-commit] spec file staged → scanning for vacuous grid loops (ALL-092, warn-only)..." >&2
  node scripts/check-vacuous-grid-assertions.mjs || true
fi

# --- 5d) LR-066: save-route parity gate. ----------------------------------------
# Fires whenever a clients/*/tests/**/*.spec.ts is staged. Asserts that every registered
# multi-route (route-param/mode sibling) save page exercises a REAL Save on EACH route — a
# sibling route closed on load + field-enable checks alone is rejected (the NM-2263 Labor
# enable-only gap). Sibling of the ALL-071 parity gate; calls node directly (no npm script,
# so no package.json edit). --staged scopes the gate to registered specs that are staged.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/tests/.*\.spec\.ts$'; then
  echo "[pre-commit] spec file staged → running save-route parity (LR-066)..." >&2
  if ! node scripts/check-save-route-parity.mjs --staged; then
    echo "[pre-commit] HALT: a save-capable sibling route is not exercising a real Save (LR-066)." >&2
    echo "         Each route-param/mode sibling needs a dialog-reach (or commit) test, or a 'parity-waived: <reason>' marker." >&2
    echo "         Inspect: node scripts/check-save-route-parity.mjs" >&2
    exit 1
  fi
fi

# --- 5e) LR-019: per-test baseline gate. ----------------------------------------
# Fires whenever a clients/*/tests/**/*.spec.ts is staged. Asserts every save-capable describe
# resets baseline PER-TEST (ensureDefaultState in beforeEach, the FCC runner baseline, or a fresh
# open()) — a first-test-only baseline is rejected. Registry-driven (scripts/check-per-test-baseline.mjs):
# the known gaps are waived pending their FCC subplan; new unguarded save-specs fail. --staged scopes
# the gate to registered/save-capable specs that are staged.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/tests/.*\.spec\.ts$'; then
  echo "[pre-commit] spec file staged → running per-test baseline gate (LR-019)..." >&2
  if ! node scripts/check-per-test-baseline.mjs --staged; then
    echo "[pre-commit] HALT: a save-capable describe lacks a per-test baseline (LR-019)." >&2
    echo "         Wire ensureDefaultState into test.beforeEach (or use the FCC runner baseline), OR register/waive it." >&2
    echo "         Inspect: npm run check:per-test-baseline" >&2
    exit 1
  fi
fi

# --- 5f) LR-067: save-honesty gate. ---------------------------------------------
# Fires whenever a clients/*/src/pages/**.ts page object is staged. Fails the commit if a save
# primitive lies on its disabled branch (reports success without saved:false), or a restore/reset/
# revert/cleanup/ensureDefault method persists shared state without verifying (saveAndVerifyPersisted
# or a retry loop) and carries no `// save-verify-exempt:` marker. Sibling of Gate 5d (LR-066) / 5e
# (LR-019); node-direct (no npm script). --staged scopes to staged page objects.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/src/pages/.*\.ts$'; then
  echo "[pre-commit] page object staged → running save-honesty gate (LR-067)..." >&2
  if ! node scripts/check-save-honesty.mjs --staged; then
    echo "[pre-commit] HALT: a save primitive lies, or a restore persists shared state without verifying (LR-067)." >&2
    echo "         Signal the no-op (saved:false) / route the restore through saveAndVerifyPersisted, OR mark // save-verify-exempt: <reason>." >&2
    echo "         Inspect: node scripts/check-save-honesty.mjs" >&2
    exit 1
  fi
fi

# --- 5g) Deliverable-remediation gate: no fixed sleeps in spec files (the DIAGNOSTIC-PAUSE class).
# Fires when a clients/*/tests/**/*.spec.ts is staged. A fixed page.waitForTimeout / hand-rolled
# setTimeout sleep flakes and never confirms the transition it waits for — use expect.poll /
# waitForFunction / waitFor instead. A legitimate prove-a-negative settle is exempt via `// sleep-ok:`.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/tests/.*\.spec\.ts$'; then
  echo "[pre-commit] spec file staged → scanning for fixed sleeps (spec-sleeps gate)..." >&2
  if ! node scripts/check-spec-sleeps.mjs --enforce; then
    echo "[pre-commit] HALT: a spec uses a fixed sleep. Replace with expect.poll / waitForFunction /" >&2
    echo "         locator.waitFor, or annotate a prove-a-negative settle with '// sleep-ok: <reason>'." >&2
    exit 1
  fi
fi

# --- 5h) Deliverable-remediation gate: no unfailable assertions in spec files.
# Fires when a clients/*/tests/**/*.spec.ts is staged. Bans swallow-to-benign (.catch(()=>'')),
# unanchored digit regex (toMatch(/\d/)), and count>=0 tautologies — assertions that pass for
# almost any value and so give false confidence.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/tests/.*\.spec\.ts$'; then
  echo "[pre-commit] spec file staged → scanning for unfailable assertions..." >&2
  if ! node scripts/check-unfailable-assertions.mjs --enforce; then
    echo "[pre-commit] HALT: a spec has an assertion that cannot fail (swallow-to-benign, unanchored" >&2
    echo "         digit regex, or count>=0). Assert the real value/shape instead." >&2
    exit 1
  fi
fi

# --- 5i) Deliverable-remediation gate: an empty catch on a load-bearing action must be justified.
# Fires when a clients/*/src/pages/**.ts page object is staged. An empty `.catch(()=>{})` on a
# click / reload / save silently discards a real failure — annotate intentional best-effort swallows
# with a `best-effort:` comment (a settle-only waitFor catch is not flagged).
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/src/pages/.*\.ts$'; then
  echo "[pre-commit] page object staged → scanning for swallowed failures..." >&2
  if ! node scripts/check-swallowed-failures.mjs --enforce; then
    echo "[pre-commit] HALT: an empty catch on a click/reload/save discards a real failure." >&2
    echo "         Add a '// best-effort: <reason>' comment if the swallow is intentional." >&2
    exit 1
  fi
fi

# --- 5j) Deliverable-remediation gate: README npm-run commands must exist in package.json.
# Fires when a README.md or package.json is staged. A documented `npm run <name>` with no matching
# script is a doc lie a collaborator will copy and hit.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '(^|/)README\.md$|(^|/)package\.json$'; then
  echo "[pre-commit] README/package.json staged → checking documented npm-run commands..." >&2
  if ! node scripts/check-doc-script-parity.mjs --enforce; then
    echo "[pre-commit] HALT: a README documents an 'npm run <name>' that its package.json lacks." >&2
    echo "         Fix the README command or add the script." >&2
    exit 1
  fi
fi

# --- 5k) Deliverable-remediation gate: a page reload must stabilize the app before continuing.
# Fires when a clients/*/src/pages/**.ts page object is staged. A this.page.reload() that is not
# followed (within the method) by waitForAngularStable races the Angular re-bootstrap. Probe reloads
# (`.reload(...).catch`) and reload closures are exempt; `// reload-wait-exempt:` overrides.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/src/pages/.*\.ts$'; then
  echo "[pre-commit] page object staged → checking reloads stabilize the app..." >&2
  if ! node scripts/check-reload-wait.mjs --enforce; then
    echo "[pre-commit] HALT: a page.reload() is not followed by waitForAngularStable (race risk)." >&2
    echo "         Add 'await this.waitForAngularStable();' after the reload, or mark // reload-wait-exempt: <reason>." >&2
    exit 1
  fi
fi

# --- 5l) Dead-export gate (remediation Phase 5 gate #10). ------------------------
# Fires when a clients/*/{src,tests}/**/*.ts is staged. Runs ts-prune against the client tsconfig and
# HALTs if a staged client file introduces an export that nobody imports (a dead export) unless it is
# registered in scripts/dead-exports-allowlist.json with a >=20-char reason. ts-prune "(used in
# module)" findings are INFO (internal use), not failures. Offline / tool-unavailable → WARN + pass
# (never wedge a commit offline). Fail-green on the clean tree (12 baseline findings allowlisted).
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/(src|tests)/.*\.ts$'; then
  echo "[pre-commit] client source staged → running dead-export gate (ts-prune)..." >&2
  if ! node scripts/check-dead-exports.mjs --staged; then
    echo "[pre-commit] HALT: a staged client file exports a symbol nobody imports (dead export)." >&2
    echo "         Delete it, or add it to scripts/dead-exports-allowlist.json with a >=20-char reason." >&2
    exit 1
  fi
fi

# --- 5m) LR-019/LR-067: weak-reset gate (remediation Phase 5 gate #6). ----------
# Fires when a clients/*/tests/**/*.spec.ts is staged. Forbids the "bare-save reset" anti-pattern:
# a save-capable describe whose beforeEach/afterEach SAVES (saveAndConfirm / clickSave*) but never
# restores a baseline (ensureDefaultState / ensureEmptyState / reloadAndReselect / FCC runner /
# fresh open()). Such a reset pins the last test's mutated state as the baseline for the next test.
# Fail-green on the clean tree (the 2026-07-06 fleet audit found zero); catches a future regression.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/tests/.*\.spec\.ts$'; then
  echo "[pre-commit] spec file staged → running weak-reset gate (LR-019/LR-067)..." >&2
  if ! node scripts/check-weak-reset.mjs --staged; then
    echo "[pre-commit] HALT: a save-capable describe resets by saving without restoring a baseline (weak reset)." >&2
    echo "         Use ensureDefaultState/ensureEmptyState/reloadAndReselect, the FCC runner, or a fresh open()." >&2
    exit 1
  fi
fi

# --- 5n) testid-preference reminder (remediation Phase 5 gate #9 — testid-first golden rule). ----
# Fires when a clients/*/src/selectors/**/*.ts is staged. Lists ADDED non-`data-testid` selector lines
# and points at the golden rule (AGENT_SHARED_RULES.md §5 + LR-014). WARN-ONLY BY DESIGN: a static gate
# cannot see the live DOM, and LR-029 says only a live-DOM check decides whether a testid truly exists,
# so this reminds — it never blocks (the golden rule explicitly allows a tracked fallback). Always exit 0.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/src/selectors/.*\.ts$'; then
  echo "[pre-commit] selector file staged → testid-preference reminder (gate #9, warn-only)..." >&2
  node scripts/check-testid-preference.mjs --staged || true
fi

# --- 5o) step-label readability gate (readable HTML report). -----------------------
# Fires when a fixture / page-object / spec is staged. Enforces three things that keep the
# client-facing Playwright HTML report in plain English: every page-object fixture is wrapped in
# wrapWithSteps(); no page-object method name derives an untranslated-jargon report label; and specs
# do not call .page.<accessor>...<action> directly (which prints raw locator code as a step title).
# --staged scopes the check to the about-to-commit files.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/(src/fixtures/pages\.fixture\.ts|src/pages/.*\.page\.ts|tests/.*\.spec\.ts)$'; then
  echo "[pre-commit] fixture/page-object/spec staged → step-label readability gate..." >&2
  if ! node scripts/check-step-labels.mjs --enforce --staged; then
    echo "[pre-commit] HALT: step-label readability gate failed (unwrapped fixture / jargon label / raw .page. action)." >&2
    echo "         Fix: wrap the fixture in wrapWithSteps(); add a jargonMap translation or rename the method; move the .page.<action> behind a labelled page-object method or wrap it in test.step()." >&2
    echo "         Inspect: node scripts/check-step-labels.mjs" >&2
    exit 1
  fi
fi

# --- 6) LR-028 + LR-037: activity-log timestamp validation. ----------------------
# Fires whenever agent-activity-log.md is staged. Guards against backdated rows
# (timestamp < latest mtime of any referenced file). --staged scopes the check to the
# rows ADDED in this commit's staged diff — the only rows where backdating can be
# introduced. This kills the false-positive class where a LATER commit legitimately
# re-touches a file an OLDER, already-committed row referenced (LR-037 fix 2026-07-06).
if git diff --cached --name-only --diff-filter=ACMR | grep -qE 'agent-activity-log\.md$'; then
  echo "[pre-commit] activity-log staged → validating LR-037 timestamps (staged rows)..." >&2
  if ! node scripts/validate-activity-log.mjs --staged --quiet; then
    echo "[pre-commit] HALT: activity-log row backdated relative to referenced file mtimes (LR-037)." >&2
    echo "         Inspect: npm run validate:activity-log:preflight" >&2
    exit 1
  fi
fi

# --- 7) LR-027 + LR-040: plan-finalization closure check. -----------------------
# Uses --staged (pre-commit blob mode) so the validator sees the about-to-be-committed
# content, not the working-tree content. Only fires when a plan file is staged.
# Defense-in-depth alongside PreToolUse plan-closure-gate.sh (catches git CLI / external editor commits).
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^plans/(pending|done)/.*\.md$'; then
  echo "[pre-commit] plan file staged → running validate-plan-closure (LR-027 + LR-040)..." >&2
  if ! node scripts/validate-plan-closure.mjs --staged --enforce; then
    echo "[pre-commit] HALT: plan Status flip without Execution Summary OR closure-gate (a/b/c) gap." >&2
    exit 1
  fi
fi

# --- 8) Enforcement-claim lint (announce mode — LR-069 ramp). -------------------
# Fires when any rule/doc/skill markdown in the claim corpus is staged.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^(CLAUDE\.md|\.claude/rules/|docs/read_only_docs/|\.claude/skills/|clients/[^/]+/CLAUDE\.md)'; then
  echo "[pre-commit] rule/doc/skill file staged → checking enforcement claims (announce)..." >&2
  node scripts/check-enforcement-claims.mjs --announce
fi

# --- 9) Stale-ref guard: refuse restructure-era dead paths in the live layer. ----
# Graduating incident: PLAN_ENCORE_POM_RESTRUCTURE delivery scripts broke on moved paths.
# Sev: S0 (broken pipeline). Unconditional: a stale reference can come from any file type
# — no trigger pattern would predict all of them; runtime ~1.8s allows unconditional fire.
echo "[pre-commit] running stale-ref guard (verify:no-stale-refs)..." >&2
if ! node scripts/verify-no-stale-live-refs.mjs; then
  echo "[pre-commit] HALT: stale pre-restructure path references in the live layer." >&2
  echo "         Inspect: npm run verify:no-stale-refs" >&2
  exit 1
fi

# --- 10) Test-case MD lint: staged-files-only authoring defect check. -------------
# Graduating incident: 31 pre-existing lint errors pushed uncaught to client delivery.
# Sev: S1 (quality drift to commit/ship). Fires only on staged test-case MDs via --staged
# so the pre-existing backlog does not block unrelated commits.
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^clients/[^/]+/specs_planning/test-cases/.+\.md$'; then
  # Guard: ts-node must be available (devDependency; absent after npm install --production).
  if [ ! -f node_modules/.bin/ts-node ] && ! command -v ts-node >/dev/null 2>&1; then
    echo "[pre-commit] WARNING: ts-node not available — skipping lint:testcases. Run 'npm install'." >&2
    mkdir -p .claude/state
    echo "tc-md-lint-gate-10, $(date -u +%Y-%m-%dT%H:%M:%SZ), skip, ts-node-unavailable" >> .claude/state/gate-fires.log
  else
    echo "[pre-commit] test-case MD staged → running lint:testcases --staged..." >&2
    if ! npx ts-node scripts/lint-test-cases.ts --staged; then
      echo "[pre-commit] HALT: test-case lint errors in staged files." >&2
      echo "         Inspect: npm run lint:testcases" >&2
      exit 1
    fi
  fi
fi

exit 0
