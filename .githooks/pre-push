#!/usr/bin/env bash
# Pre-push hook — Path A ship-discipline enforcement.
# Register with: npm run plans:hooks:install (sets core.hooksPath = .githooks)

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 1. If staged changes touch any clients/<id>/dist/framework/, verify vendor-fresh.
for client_dir in clients/*/; do
  [ -d "$client_dir" ] || continue
  client_id="${client_dir%/}"; client_id="${client_id##*/}"
  if git diff --cached --name-only HEAD 2>/dev/null | grep -qE "^clients/$client_id/dist/framework/"; then
    node scripts/verify-vendor-fresh.mjs --client="$client_id"
  fi
done

# DEPRECATED 2026-05-19 — vendoring removed in PLAN_DIST_REGRESSION_AND_N_FIXES.
# verify-vendor-fresh now always succeeds (meta absent → exit 0) so this block is a no-op loop.
# Cleanup tracked by PLAN_ROOT_CLIENT_DEDUPE.md.
# 2. If staged changes touch src/, ALL clients/*/dist/framework/ must be re-vendored.
if git diff --cached --name-only HEAD 2>/dev/null | grep -qE "^src/"; then
  for client_dir in clients/*/; do
    [ -d "$client_dir" ] || continue
    client_id="${client_dir%/}"; client_id="${client_id##*/}"
    if ! node scripts/verify-vendor-fresh.mjs --client="$client_id"; then
      echo "[pre-push] src/ changed but clients/$client_id/dist/framework/ is stale. (DEPRECATED — no-op since 2026-05-19; see PLAN_ROOT_CLIENT_DEDUPE.md)" >&2
      exit 1
    fi
  done
fi

# 3. Per-file deny-list grep against staged paths.
git diff --cached --name-only HEAD 2>/dev/null | while read -r staged_file; do
  [ -z "$staged_file" ] && continue
  node scripts/verify-no-forbidden.mjs --staged="$staged_file" || exit 1
done

# 4. Workbook content-freshness + reproducibility gate — last-line defense vs a
# `git commit --no-verify` that skipped the pre-commit gate, or post-commit drift.
# Runs the rebuild-diff + reproducibility check if the commits being pushed touch any
# workbook input.
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
RUN_FRESHNESS=0
if git rev-parse --verify --quiet "origin/$BRANCH" >/dev/null 2>&1; then
  if git diff --name-only "origin/$BRANCH"..HEAD \
       | grep -qE '^clients/[^/]+/tests/.*\.spec\.ts$|^clients/[^/]+/specs_planning/test-cases/.+\.md$|^clients/[^/]+/test_cases_xlsx/.+\.xlsx$|^export_test_cases/.+\.(ts|json)$'; then
    RUN_FRESHNESS=1
  fi
else
  RUN_FRESHNESS=1 # no upstream yet — establishing the branch; verify freshness once
fi
if [ "$RUN_FRESHNESS" -eq 1 ]; then
  echo "[pre-push] running xlsx freshness gate..." >&2
  if ! npm run --silent xlsx:freshness; then
    echo "[pre-push] HALT: deliverable workbook is stale or was built from uncommitted generators." >&2
    exit 1
  fi
fi

exit 0
