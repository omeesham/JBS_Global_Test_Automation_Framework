#!/usr/bin/env bash
# Pre-push hook — Path A ship-discipline enforcement.
# Sev S1 — graduating incident: two colleagues blocked by upstream plans with
# broken closure (2026-08-18). Prior-fix verdict: commit-time check is
# scoped-wrong — it sits on the machine where the defect is invisible.
# Register with: npm run plans:hooks:install (sets core.hooksPath = .githooks)

set -e
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

BRANCH="$(git rev-parse --abbrev-ref HEAD)"

# 1. Plan-closure gate — grade only plans whose content changed in this push.
# stdin format per git: <local_ref> <local_sha> <remote_ref> <remote_sha>
# Save stdin to fd 3 so commands inside the loop cannot consume the ref list.
exec 3<&0
PLAN_GATE_FAILED=0
REFS_PROCESSED=0
while read -r local_ref local_sha remote_ref remote_sha <&3; do
  REFS_PROCESSED=$((REFS_PROCESSED + 1))

  # Skip delete pushes
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  # Determine baseline: if remote has no such ref, no baseline — skip grading.
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    echo "[pre-push/plan-closure] New branch — no remote baseline; skipping plan-closure grading." >&2
    continue
  fi

  # Find plan files whose content changed in the push range
  changed_plans=()
  while IFS= read -r -d '' pfile; do
    changed_plans+=("$pfile")
  done < <(git diff -z --name-only --diff-filter=d "$remote_sha".."$local_sha" -- 'plans/*.md' 'plans/**/*.md')

  if [ ${#changed_plans[@]} -eq 0 ]; then
    continue
  fi

  for plan in "${changed_plans[@]}"; do
    # Validate directly: write blob to temp file, feed to validator without a pipe
    # so the exit code is measured from the validator alone, never masked by pipefail.
    PLAN_TMPFILE="$(mktemp)"
    if ! git show "${local_sha}:${plan}" > "$PLAN_TMPFILE" 2>/dev/null; then
      echo "[pre-push/plan-closure] DENY: cannot retrieve ${plan} at ${local_sha:0:12} — treating as closure failure." >&2
      rm -f "$PLAN_TMPFILE"
      PLAN_GATE_FAILED=1
      continue
    fi
    PLAN_BYTES="$(wc -c < "$PLAN_TMPFILE")"
    if [ "$PLAN_BYTES" -eq 0 ]; then
      echo "[pre-push/plan-closure] DENY: ${plan} is empty at ${local_sha:0:12} — treating as closure failure." >&2
      rm -f "$PLAN_TMPFILE"
      PLAN_GATE_FAILED=1
      continue
    fi
    if ! node scripts/validate-plan-closure.mjs --content-from-stdin --plan "$plan" --enforce < "$PLAN_TMPFILE" 2>&1; then
      echo "[pre-push/plan-closure] DENY: $plan fails closure check." >&2
      mkdir -p .claude/state
      echo "plan-closure-prepush, $(date -u +%Y-%m-%dT%H:%M:%SZ), deny, $plan" >> .claude/state/gate-fires.log
      PLAN_GATE_FAILED=1
    fi
    rm -f "$PLAN_TMPFILE"
  done
done
exec 3<&-

if [ "$REFS_PROCESSED" -eq 0 ]; then
  echo "[pre-push/plan-closure] WARNING: no refs received on stdin — hook had nothing to evaluate." >&2
fi

if [ "$PLAN_GATE_FAILED" -eq 1 ]; then
  echo "[pre-push/plan-closure] Push rejected — fix the plan(s) above before pushing." >&2
  exit 1
fi

# 3. Per-file deny-list grep against pushed commits.
# Scans the commits actually being pushed (origin/$BRANCH..HEAD); when no upstream
# exists, scans the full tracked tree once (same fallback posture as section 4).
# Uses -z (NUL-delimited) output so paths with non-ASCII bytes (e.g. em-dash U+2014)
# are emitted raw — no C-style quoting/octal escaping that breaks downstream git show.
while IFS= read -r -d '' pushed_file; do
  [ -z "$pushed_file" ] && continue
  node scripts/verify-no-forbidden.mjs --head-file="$pushed_file" || {
    echo "[pre-push] DENY: forbidden pattern in $pushed_file" >&2
    mkdir -p .claude/state
    echo "pre-push-leak-scan, $(date -u +%Y-%m-%dT%H:%M:%SZ), deny, $pushed_file" >> .claude/state/gate-fires.log
    exit 1
  }
done < <(
  if git rev-parse --verify --quiet "origin/$BRANCH" >/dev/null 2>&1; then
    git diff -z --name-only --diff-filter=d "origin/$BRANCH"..HEAD
  else
    git ls-files -z
  fi
)

# 4. Workbook content-freshness + reproducibility gate — last-line defense vs a
# `git commit --no-verify` that skipped the pre-commit gate, or post-commit drift.
# Runs the rebuild-diff + reproducibility check if the commits being pushed touch any
# workbook input.
RUN_FRESHNESS=0
if git rev-parse --verify --quiet "origin/$BRANCH" >/dev/null 2>&1; then
  if git diff --name-only "origin/$BRANCH"..HEAD \
       | grep -qE '^clients/[^/]+/tests/.*\.spec\.ts$|^clients/[^/]+/specs_planning/test-cases/.+\.md$|^clients/[^/]+/testcases/.+\.xlsx$|^export_test_cases/.+\.(ts|json)$'; then
    RUN_FRESHNESS=1
  fi
else
  RUN_FRESHNESS=1 # no upstream yet — establishing the branch; verify freshness once
fi
if [ "$RUN_FRESHNESS" -eq 1 ]; then
  echo "[pre-push] running xlsx freshness gate..." >&2
  if ! npm run --silent xlsx:freshness; then
    echo "[pre-push] HALT: deliverable workbook is stale or was built from uncommitted generators." >&2
    exit 1
  fi
fi

# 5. Gate-input closure (PLAN_TEAM_REPO_GATE_INPUT_CLOSURE P3, Sev S1).
# The parity and field-inventory gates read test-case md / test-plan md / field-inventory md
# from the WORKING TREE — a file that exists here but is untracked satisfies them locally
# while every clone fails them (2026-08-12 incident: 170 orphan TCs, five days blocked).
# Ramp per LR-069: announce (warn + telemetry) until untracked_gate_inputs_mode=deny.
GATE_INPUTS_MODE="$(node -e "try{process.stdout.write(JSON.parse(require('fs').readFileSync('.claude/guardrail-config.json','utf8')).untracked_gate_inputs_mode||'announce')}catch{process.stdout.write('announce')}")"
if [ "$GATE_INPUTS_MODE" != "off" ]; then
  if ! node scripts/check-untracked-knowledge.mjs --enforce-gate-inputs >&2; then
    mkdir -p .claude/state
    echo "gate-input-closure, $(date -u +%Y-%m-%dT%H:%M:%SZ), $GATE_INPUTS_MODE, pre-push" >> .claude/state/gate-fires.log
    if [ "$GATE_INPUTS_MODE" = "deny" ]; then
      echo "[pre-push] HALT: untracked gate-input files (see list above) — track them or the clone-side gates fail." >&2
      exit 1
    fi
    echo "[pre-push] ANNOUNCE: untracked gate-input files detected (push proceeds; deny after ramp)." >&2
  fi
fi

exit 0
