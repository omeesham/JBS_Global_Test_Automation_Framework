{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Active Task State",
  "description": "Schema for the singleton active task tracking file",
  "type": "object",
  "required": ["task_id", "verification_dir", "phase"],
  "properties": {
    "task_id": {
      "type": ["string", "null"],
      "description": "Current active task ID or null if idle"
    },
    "verification_dir": {
      "type": ["string", "null"],
      "description": "Path to verification directory or null if no active verification"
    },
    "phase": {
      "type": "string",
      "enum": ["idle", "development", "qa_review", "worker_validation", "completed"],
      "description": "Current workflow phase"
    },
    "last_worker_action": {
      "type": ["object", "null"],
      "description": "Last action taken by worker/dev agent",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "action": {
          "type": "string",
          "description": "Action description (e.g., 'implemented feature', 'validated QA findings')"
        },
        "files_modified": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of files modified in this action"
        },
        "status": {
          "type": "string",
          "enum": ["success", "failure", "precheck_fail"],
          "description": "Action outcome"
        },
        "artifact_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Artifact files created (e.g., pre_dev_check.md, 2_worker_feedback.md)"
        }
      },
      "required": ["timestamp", "action", "status"]
    },
    "last_qa_action": {
      "type": ["object", "null"],
      "description": "Last action taken by QA agent",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "action": {
          "type": "string",
          "description": "Action description (e.g., 'reviewed files', 'wrote findings')"
        },
        "files_reviewed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of files reviewed"
        },
        "status": {
          "type": "string",
          "enum": ["findings_created", "validation_requested", "completed"],
          "description": "QA action status"
        },
        "artifact_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Artifact files created (e.g., 1_initial_findings.md)"
        }
      },
      "required": ["timestamp", "action", "status"]
    }
  }
}
