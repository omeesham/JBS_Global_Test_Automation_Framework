# =============================================================================
# STAGING ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains staging environment settings.
# Secrets should be overridden in CI/CD platform or .env.staging.local
# =============================================================================

# Environment
CI_ENV=staging

# Application URLs (staging server)
BASE_URL=https://staging-app.example.com
HOME_URL=https://staging-app.example.com
API_BASE_URL=https://staging-api.example.com

# Timeouts (standard timeouts)
TIMEOUT_DEFAULT=30000
TIMEOUT_NAVIGATION=60000
TIMEOUT_ACTION=15000
TIMEOUT_ASSERTION=5000

# Database (staging database - credentials from CI secrets)
DB_HOST=staging-db.example.com
DB_PORT=5432
DB_USER=staging_user
DB_PASSWORD=***SET_IN_CI_SECRETS***
DB_NAME=staging_db
DB_TYPE=postgresql

# AWS S3 (staging bucket - credentials from CI secrets)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=***SET_IN_CI_SECRETS***
AWS_SECRET_ACCESS_KEY=***SET_IN_CI_SECRETS***
S3_BUCKET=staging-test-data

# Test Credentials (staging test accounts - set in CI)
ADMIN_USERNAME=staging_admin
ADMIN_PASSWORD=***SET_IN_CI_SECRETS***
USER_USERNAME=staging_user
USER_PASSWORD=***SET_IN_CI_SECRETS***

# Feature Flags (enable tracing for debugging)
ENABLE_TRACING=true
ENABLE_VIDEO=false
ENABLE_SCREENSHOTS=true
ENABLE_API_MOCKING=false

# Retry Configuration (retry flaky tests)
RETRY_COUNT=2
MAX_FAILURES=10

# Browser Configuration (headless for CI)
DEFAULT_BROWSER=chrome
HEADLESS=true

# Logging
LOG_LEVEL=info
LOG_FILE=logs/staging-execution.log

# OpenAI (enable if API key available in CI)
# OPENAI_API_KEY=***SET_IN_CI_SECRETS***
ENABLE_OPENAI_SELF_HEALING=false

# CI detection
CI=true
