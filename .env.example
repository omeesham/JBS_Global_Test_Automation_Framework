# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# This file serves as a template for environment-specific configuration.
# Copy this file to create environment-specific versions:
#   - .env.development (local development)
#   - .env.staging (staging environment)
#   - .env.production (production environment)
#   - .env.local (local overrides, NOT committed to Git)
#
# IMPORTANT: Never commit actual secrets to Git!
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT IDENTIFICATION
# -----------------------------------------------------------------------------
CI_ENV=development
# CI=false

# -----------------------------------------------------------------------------
# APPLICATION URLs (EspoCRM)
# -----------------------------------------------------------------------------
BASE_URL=https://demo.us.espocrm.com/
HOME_URL=https://demo.us.espocrm.com/#Home
API_BASE_URL=https://demo.us.espocrm.com/api/v1

# -----------------------------------------------------------------------------
# TIMEOUTS (in milliseconds)
# -----------------------------------------------------------------------------
TIMEOUT_DEFAULT=30000
TIMEOUT_NAVIGATION=60000
TIMEOUT_ACTION=15000
TIMEOUT_ASSERTION=5000
TEST_TIMEOUT=30000
EXPECT_TIMEOUT=5000
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (optional - for DB data adapter)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name
DB_TYPE=postgresql

# -----------------------------------------------------------------------------
# AWS S3 CONFIGURATION (optional - for S3 data adapter)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_SESSION_TOKEN=your_session_token
S3_BUCKET=your-test-data-bucket

# -----------------------------------------------------------------------------
# TEST CREDENTIALS (EspoCRM)
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here
USER_USERNAME=testuser
USER_PASSWORD=your_user_password_here

# MFA/TOTP Secrets (Base32 encoded, if 2FA is enabled)
MFA_SECRET=YOUR_BASE32_ENCODED_SECRET_HERE

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
ENABLE_TRACING=true
ENABLE_VIDEO=true
ENABLE_SCREENSHOTS=true
ENABLE_API_MOCKING=false

# -----------------------------------------------------------------------------
# RETRY CONFIGURATION
# -----------------------------------------------------------------------------
RETRY_COUNT=2
MAX_FAILURES=10

# -----------------------------------------------------------------------------
# BROWSER CONFIGURATION
# -----------------------------------------------------------------------------
DEFAULT_BROWSER=chrome
HEADLESS=false

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE=logs/test-execution.log

# -----------------------------------------------------------------------------
# ESPOCRM API (for API testing)
# -----------------------------------------------------------------------------
# EspoCRM REST API uses Basic Auth or API Key
# ESPOCRM_API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# DOWNLOAD / FILE OPERATIONS
# -----------------------------------------------------------------------------
DOWNLOAD_DIR=tests/test-data/downloads
DOWNLOAD_TIMEOUT=60000

# -----------------------------------------------------------------------------
# SHAREPOINT INTEGRATION
# Required: Azure AD app registration with Sites.ReadWrite.All permission
# -----------------------------------------------------------------------------
SHAREPOINT_SITE_URL=https://your-tenant.sharepoint.com/sites/your-site
SHAREPOINT_CLIENT_ID=your_client_id
SHAREPOINT_CLIENT_SECRET=your_client_secret
SHAREPOINT_TENANT_ID=your_tenant_id
SHAREPOINT_UPLOAD_PATH=/Shared Documents/Test Reports/
