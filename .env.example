# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# This file serves as a template for environment-specific configuration.
# Copy this file to create environment-specific versions:
#   - .env.development (local development)
#   - .env.staging (staging environment)
#   - .env.production (production environment)
#   - .env.local (local overrides, NOT committed to Git)
#
# IMPORTANT: Never commit actual secrets to Git!
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT IDENTIFICATION
# -----------------------------------------------------------------------------
CI_ENV=development
# CI=false

# -----------------------------------------------------------------------------
# APPLICATION URLs
# -----------------------------------------------------------------------------
BASE_URL=http://localhost:3000
HOME_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api

# -----------------------------------------------------------------------------
# TIMEOUTS (in milliseconds)
# -----------------------------------------------------------------------------
TIMEOUT_DEFAULT=30000
TIMEOUT_NAVIGATION=60000
TIMEOUT_ACTION=15000
TIMEOUT_ASSERTION=5000
TEST_TIMEOUT=30000
EXPECT_TIMEOUT=5000
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name
DB_TYPE=postgresql

# -----------------------------------------------------------------------------
# AWS S3 CONFIGURATION
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_SESSION_TOKEN=your_session_token
S3_BUCKET=your-test-data-bucket

# -----------------------------------------------------------------------------
# TEST CREDENTIALS
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password_here
USER_USERNAME=testuser
USER_PASSWORD=user_password_here

# Legacy credentials (for backward compatibility)
USERNAME_AUTOMATION=test_user
PASSWORD_AUTOMATION=test_password

# MFA/TOTP Secrets (Base32 encoded)
MFA_SECRET=YOUR_BASE32_ENCODED_SECRET_HERE

# -----------------------------------------------------------------------------
# OPENAI CONFIGURATION (for self-healing locators and QA agent)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
ENABLE_OPENAI_SELF_HEALING=false

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
ENABLE_TRACING=true
ENABLE_VIDEO=true
ENABLE_SCREENSHOTS=true
ENABLE_API_MOCKING=false

# -----------------------------------------------------------------------------
# RETRY CONFIGURATION
# -----------------------------------------------------------------------------
RETRY_COUNT=2
MAX_FAILURES=10

# -----------------------------------------------------------------------------
# BROWSER CONFIGURATION
# -----------------------------------------------------------------------------
DEFAULT_BROWSER=chrome
HEADLESS=false

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE=logs/test-execution.log

# -----------------------------------------------------------------------------
# ESPOCRM SPECIFIC (optional)
# -----------------------------------------------------------------------------
# ESPOCRM_URL=https://your-instance.espocrm.com
# ESPOCRM_API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# ADDITIONAL CONFIGURATION
# -----------------------------------------------------------------------------
# Add project-specific environment variables below:
# EMAIL_SMTP_HOST=smtp.example.com
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

