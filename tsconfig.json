/**
 * @agent-doc
 * PURPOSE: TypeScript compiler configuration for the framework (framework-only scope — demoted per SUBPLAN_RCD_C_ENV_REPORTS_CRUFT 2026-07-16). Covers src/ (framework source) and pipeline/ only. Client tsconfig lives at clients/encore/tsconfig.json.
 * OWNER: human-only
 * IMPACT: critical - All TypeScript compilation for framework/pipeline depends on this. Breaking it prevents builds. Type checking rules affect code quality.
 * DEPENDS-ON: None (TypeScript built-in)
 * USED-BY: TypeScript compiler (tsc), VS Code IntelliSense, npm run typecheck
 * RULES: Never disable strict checks. Keep ES2022 target for modern features. Keep paths aligned with framework/pipeline layout. clients/** excluded — each client has its own tsconfig. Changes require full rebuild and typecheck.
 */

{
  "compilerOptions": {
    // Language and Environment
    "target": "ES2022",
    "lib": ["ES2022", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",

    // Path aliases (framework-only — demoted per SUBPLAN_RCD_C_ENV_REPORTS_CRUFT 2026-07-16).
    // @client/* and @client-tests/* removed; clients/encore has its own tsconfig.json.
    //   @framework/* resolves to framework src/
    //   @pipeline/* resolves to pipeline/ (internal runtime)
    "baseUrl": "./",
    "paths": {
      "@framework/*": ["src/*"],
      "@pipeline/*": ["pipeline/*"]
    },
    
    // Emit
    "outDir": "./.build",
    "rootDir": "./",
    "sourceMap": true,
    "removeComments": false,
    "declaration": true,
    "declarationMap": true,
    
    // Interop Constraints
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    
    // Type Checking
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": false,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    
    // Completeness
    "skipLibCheck": true,
    
    // Experimental
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    
    // Advanced
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".build",
    "reports",
    "logs",
    "playwright-report",
    "client-delivery",
    "_migration_global_claude",
    // Self-managed sub-projects: each has its own tsconfig + build command
    // (pipeline/tsconfig.json via build:server, website/{backend,frontend},
    // clients/encore/tsconfig.json). Root typecheck owns only root src/, scripts/,
    // export_test_cases/. Excluding these prevents the root commonjs/node config
    // from wrongly compiling ESM/bundler sub-projects.
    "website",
    "pipeline",
    "clients",
    "scripts/walk-coverage/fixtures"
  ]
}
