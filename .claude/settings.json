{
  "permissions": {
    "allow": [
      "Bash(npm run validate:activity-log:preflight *)",
      "Bash(npm run plans:reindex:check)",
      "Bash(npm run plans:reindex)",
      "Bash(npm run validate:sync)",
      "Bash(npm run typecheck)",
      "Bash(npm run check:browsertool-parity)",
      "Bash(bash .claude/hooks/chain-orchestrator.sh)",
      "Bash(bash .claude/hooks/chain-pause-notice.sh)",
      "Bash(bash .claude/hooks/identity-switch-gate.sh)",
      "Bash(bash .claude/hooks/browsertool-gate.sh)",
      "Bash(node scripts/check-identity-ownership.mjs)",
      "Bash(node scripts/check-browsertool-parity.mjs)",
      "Bash(node scripts/check-subplan-identity.mjs *)",
      "Bash(node .claude/hooks/lib/test-browsertool-fixtures.mjs)",
      "Bash(bash .claude/hooks/todo-injection-gate.sh *)",
      "Bash(node .claude/hooks/lib/check-todo-injection.mjs *)",
      "Bash(bash .claude/hooks/rca-verdict-gate.sh *)",
      "Bash(node .claude/hooks/lib/check-rca-verdict.mjs *)",
      "Bash(bash .claude/hooks/execution-completion-gate.sh *)",
      "Bash(node .claude/hooks/lib/check-execution-completion.mjs *)",
      "Bash(node .claude/hooks/lib/test-execution-completion-fixtures.mjs)",
      "Bash(bash .claude/hooks/bug-baseline-gate.sh *)",
      "Bash(node .claude/hooks/lib/check-bug-baseline.mjs *)",
      "Bash(node .claude/hooks/lib/test-bug-baseline-fixtures.mjs)",
      "Bash(bash .claude/hooks/relevant-injection.sh *)",
      "Bash(node .claude/hooks/lib/relevant-injection.mjs *)",
      "Bash(node scripts/run-relevant-scan.mjs *)",
      "Bash(bash .claude/hooks/plan-closure-gate.sh *)",
      "Bash(node .claude/hooks/lib/check-plan-closure.mjs *)",
      "Bash(node scripts/validate-plan-closure.mjs *)",
      "Bash(node scripts/validate-overrides.mjs *)",
      "Bash(node scripts/validate-plan-layout.mjs *)",
      "Bash(npm run plans:validate-closure *)",
      "Bash(npm run plans:validate-overrides *)",
      "Bash(npm run plans:validate-layout *)",
      "Bash(npm run plans:validate-closure:changed *)",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__Claude_in_Chrome__read_network_requests",
      "mcp__Claude_in_Chrome__tabs_context_mcp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/identity-switch-gate.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/todo-injection-gate.sh --validate"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/plan-closure-gate.sh --edit-mode"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/jargon-gate.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/bug-baseline-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__Claude_in_Chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/browsertool-gate.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/plan-closure-gate.sh --bash-mode"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TodoWrite|TaskList",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/todo-injection-gate.sh --capture"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/chain-orchestrator.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/rca-verdict-gate.sh --validate"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/execution-completion-gate.sh --validate"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/chain-pause-notice.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/relevant-injection.sh"
          }
        ]
      }
    ]
  }
}
