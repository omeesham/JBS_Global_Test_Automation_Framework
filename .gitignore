# scripts/ticket-skill-scan.mjs hard-requires it and FATALs without it.
.claude/state/ua-worker/*
!.claude/state/ua-worker/skill-transfer-registry.md

!.claude/state/.gitkeep
!.claude/state/chain-sessions-green/.gitkeep
