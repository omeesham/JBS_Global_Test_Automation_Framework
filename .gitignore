yarn.lock
pnpm-lock.yaml
.build/
/dist/
/dist-pipeline/
# Per-client build artifacts (parallel to /dist/ and /dist-pipeline/).
# Post-2026-05-19: clients don't ship pre-built artifacts — `src/` lives inside
# clients/<id>/ and Playwright loads .ts reporters directly.
clients/*/dist/
client-delivery/
*.tsbuildinfo
*.js.map
*.d.ts.map

# Playwright
test-results/
playwright-report/
playwright/.cache/
.playwright/

