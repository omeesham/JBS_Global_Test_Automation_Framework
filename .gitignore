logs/*
*.log
!logs/README.md
*.out

# Reports — all generated output ignored, dirs created at runtime by global-setup.ts + ensure-report-dirs.js
reports/*
!reports/.gitkeep
/allure-results/
/allure-report/
/html-report/
screenshots/
!screenshots/.gitkeep

