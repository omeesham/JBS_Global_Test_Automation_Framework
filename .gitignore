# Windows null device artifact
nul

# Temporary per-task files (worker MCP configs)
.tmp/

# Node / TypeScript
node_modules/
npm-debug.log
yarn-error.log
yarn.lock
pnpm-lock.yaml
.build/
/dist/
/dist-pipeline/
client-delivery/
*.tsbuildinfo
*.js.map
*.d.ts.map

# Playwright
test-results/
playwright-report/
playwright/.cache/
.playwright/

# Logs
logs/*
*.log
!logs/README.md
*.out

# Reports — all generated output ignored, dirs created at runtime by global-setup.ts + ensure-report-dirs.js
reports/*
!reports/.gitkeep
/allure-results/
/allure-report/
/html-report/
screenshots/
!screenshots/.gitkeep

# Environment
.env
.env.local
.env.*.local
config/environments/.env.*.local
# Use .env.example / .env.server.example as templates — never commit real .env files
config/environments/.env.local
config/environments/.env.server

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.directory

# IDEs
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace
.fleet/

# Testing
coverage/
.nyc_output/

# Downloads (test artifacts) — post-SP-MT-02 location
clients/*/tests/test-data/downloads/
!clients/*/tests/test-data/downloads/.gitkeep

# Temporary
temp/
tmp/
*.tmp

# Database
*.db
*.sqlite
*.sqlite3

# Security files
*token*
*.pem
*.key

# Auth sessions
.auth/

# Root artifact junk (defensive — anchored to repo root)
/li_run*.txt
/seed.spec.ts

# MCP browser session artifacts
.playwright-mcp/

# Private skills (never commit)
.claude/skills/end-day/
.claude/skills/end-week/
specs_planning/_internal/daily-status-bank.json

# Agent audit reports (internal only - proprietary)
specs_planning/audits/*.md
!specs_planning/audits/.gitkeep

# Agent performance tracking (internal only - proprietary)
specs_planning/agent-performance.json
specs_planning/_internal/agent-activity-log.md

# Playwright browsers cache
.browsers/
ms-playwright/

# Claude Code — team files tracked, personal files ignored
# Tracked for collaborators: CLAUDE.md, .claude/skills/, .claude/agents/,
#   .claude/context/, .claude/PROTOCOL.md, .claude/AGENT_SCHOOL.md,
#   .claude/launch.json, website/.claude/launch.json
.claude/settings.local.json
website/.claude/settings.local.json
.claude/channel/
.claude/worktrees/
.claude/scheduled-tasks/
.claude/plans/
.claude/private/
current_plan.md

# Chain orchestration runtime state (see PLAN_CHAIN_PER_SESSION_ORCHESTRATION.md; only .gitkeep tracked)
.claude/state/*.json
.claude/state/*.log
.claude/state/*.lock
.claude/state/chain.STOP
.claude/state/chain-sessions/
.claude/state/chain-archive/
.claude/state/chain-sessions-green/*
!.claude/state/.gitkeep
!.claude/state/chain-sessions-green/.gitkeep

# Bundle smoke test sandbox (ephemeral — created outside repo, but guard against accidental in-repo recreation)
encore_bundle_sandbox/

# Server env — shared for team onboarding
# config/environments/.env.server

# Screenshots / junk artifacts (root level only)
/phase4-chat.jpeg
/*.jpeg
/*.png

# Generated artifacts (not tracked)
export_test_cases/exports/
specs_planning/_internal/agent-metrics-report.md
specs_planning/_internal/test-id-registry.json

# Website (JBS IntelliQE)
website/frontend/node_modules/
website/backend/node_modules/
website/frontend/dist/
website/backend/dist/
website/frontend/.env
website/backend/.env

# -----------------------------------------------------------------------------
# Multi-tenant layout (SP-MT-01 — see PLAN_MULTI_TENANT_RESTRUCTURE)
# -----------------------------------------------------------------------------
# `clients/<id>/` is tracked — per-client source, specs, config, and docs live
# here. Per-client generated artifacts mirror the root-level rules above.

# Per-client personal env overrides (mirror of config/environments/.env.*.local)
clients/*/config/environments/.env.local
clients/*/config/environments/.env.*.local
clients/*/config/environments/.env.server

# Per-client agent / pipeline artifacts — never ship to clients via git archive.
# These patterns live HERE (not in clients/<id>/.gitignore) so the per-client
# .gitignore stays customer-neutral (no internal terminology in shipped output).
clients/*/CLAUDE.md
clients/*/specs_planning/
clients/*/readable_externals/
clients/*/docs/read_only_docs/
clients/*/exports/
clients/*/.auth/

# Per-client private skills (mirror of specs_planning/_internal/daily-status-bank.json)
clients/*/specs_planning/_internal/daily-status-bank.json

# Per-client agent audit reports (mirror of specs_planning/audits/*.md)
clients/*/specs_planning/audits/*.md
!clients/*/specs_planning/audits/.gitkeep

# Per-client agent runtime state (mirror of specs_planning/_internal/*)
clients/*/specs_planning/_internal/agent-activity-log.md
clients/*/specs_planning/_internal/agent-performance.json
clients/*/specs_planning/_internal/agent-metrics-report.md
clients/*/specs_planning/_internal/test-id-registry.json
