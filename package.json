{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "description": "Playwright TypeScript automation framework with Page Object Model",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chrome": "playwright test --project=chrome",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:adapters": "playwright test --config=playwright.config.ts \"src/data/adapters/__tests__/**/*.spec.ts\"",
    "report": "playwright show-report",
    "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "setup": "npm install && npx playwright install",
    "setup:browsers": "npx playwright install chromium firefox webkit",
    "clean": "rimraf reports/* logs/* test-results/*",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "page-object-model",
    "e2e"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "allure-commandline": "^2.25.0",
    "allure-playwright": "^2.10.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.984.0",
    "axios": "^1.13.4",
    "csv-parse": "^5.5.3",
    "csv-stringify": "^6.4.5",
    "dotenv": "^16.3.1",
    "dotenv-flow": "^4.1.0",
    "knex": "^3.1.0",
    "openai": "^4.20.1",
    "otplib": "^12.0.1",
    "pg": "^8.18.0",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
