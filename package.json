{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "description": "Playwright TypeScript automation framework with Page Object Model",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "npm test --prefix clients/encore",
    "test:adapters": "playwright test --config=playwright.config.framework.ts",
    "report": "playwright show-report reports/html-report",
    "test:daily": "npm run test:daily --prefix clients/encore",
    "clean:results": "node -e \"const fs=require('fs'),p='reports/allure-results',keep=new Set(['categories.json','environment.properties','history']);fs.readdirSync(p).filter(f=>!keep.has(f)).forEach(f=>fs.unlinkSync(p+'/'+f));console.log('[OK] allure-results cleaned (config + history preserved)')\"",
    "test:clean": "npm run clean:results && npm test",
    "audit:block": "ts-node scripts/audit-block.ts",
    "setup": "npm install && npx playwright install",
    "setup:browsers": "npx playwright install chromium firefox webkit",
    "clean": "rimraf reports/allure-results reports/allure-report reports/diagnostics reports/walkthrough reports/html-report reports/test-results reports/test-results.json reports/failure-summary.json reports/junit-results.xml reports/preflight-check.json reports/fixme-registry.json reports/quality-report.pdf logs/test-execution.log",
    "clean:reports": "rimraf reports/html-report reports/allure-results reports/allure-report reports/test-results reports/test-results.json reports/failure-summary.json reports/junit-results.xml",
    "clean:root": "ts-node scripts/clean-root.ts",
    "clean:artifacts": "ts-node scripts/clean-artifacts.ts",
    "cleanup:logs": "ts-node scripts/cleanup-logs.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "lint:testcases": "ts-node scripts/lint-test-cases.ts",
    "sync:mistakes": "ts-node scripts/sync-agent-mistakes.ts",
    "sync:mistakes:dry": "ts-node scripts/sync-agent-mistakes.ts --dry-run",
    "capture:mistake": "ts-node scripts/capture-mistake.ts",
    "validate:sync": "ts-node scripts/validate-agent-sync.ts",
    "validate:activity-log": "node scripts/validate-activity-log.mjs",
    "validate:activity-log:preflight": "node scripts/validate-activity-log.mjs --staged",
    "test:validate-activity-log": "node scripts/validate-activity-log.test.mjs",
    "validate:tc-has-fieldinventory": "node scripts/check-tc-has-fieldinventory.mjs",
    "test:tc-has-fieldinventory": "node scripts/check-tc-has-fieldinventory.test.mjs",
    "validate:tc-mcp-citations": "node scripts/check-tc-mcp-citations.mjs",
    "test:tc-mcp-citations": "node scripts/check-tc-mcp-citations.test.mjs",
    "validate:fieldinventory-staleness": "node scripts/check-fieldinventory-staleness.mjs",
    "test:fieldinventory-staleness": "node scripts/check-fieldinventory-staleness.test.mjs",
    "validate:vacuous-grid": "node scripts/check-vacuous-grid-assertions.mjs",
    "test:vacuous-grid": "node scripts/check-vacuous-grid-assertions.test.mjs",
    "build:context": "ts-node scripts/task-context-builder.ts",
    "build:context:json": "ts-node scripts/task-context-builder.ts --json",
    "metrics:agents": "ts-node scripts/agent-metrics.ts",
    "metrics:agents:json": "ts-node scripts/agent-metrics.ts --json",
    "metrics:update-trust": "ts-node scripts/agent-metrics.ts --update-trust",
    "planner:post-complete": "ts-node scripts/planner-post-complete.ts",
    "planner:export-all": "ts-node scripts/planner-post-complete.ts --all",
    "pipeline:validate": "npm run validate:sync && npm run queue:validate && npm run lint:testcases && npm run detect:duplication && npm run plans:validate-overrides && npm run plans:validate-closure:changed && npm run plans:validate-layout && npm run verify:rules-fire && npm run verify:protected-names && npm run test:shared-paths && npm run check:coverage-manifest && npm run verify:no-stale-refs && npm run check:ramp-expiry && npm run check:dispatch-argv && npm run check:fixture-provenance",
    "pipeline:preflight": "npm run validate:sync && npm run build:context && npm run lint:testcases && npm run validate:activity-log:preflight",
    "queue:archive": "ts-node scripts/archive-queue.ts",
    "queue:archive:dry": "ts-node scripts/archive-queue.ts --dry-run",
    "queue:compact": "ts-node scripts/archive-queue.ts --compact",
    "queue:validate": "ts-node scripts/validate-queue-integrity.ts",
    "detect:duplication": "ts-node scripts/detect-duplication.ts",
    "generator:post-complete": "ts-node scripts/generator-post-complete.ts",
    "generator:validate-selectors": "ts-node scripts/generator-validate-selectors.ts",
    "generator:pre-run": "ts-node scripts/generator-pre-run.ts",
    "selectors:catalog": "npx ts-node scripts/generate-selector-catalog.ts",
    "requirements:pre-run": "ts-node scripts/requirements-pre-run.ts",
    "requirements:post-complete": "ts-node scripts/requirements-post-complete.ts",
    "healer:pre-run": "ts-node scripts/healer-pre-run.ts",
    "audit:pre-run": "ts-node scripts/audit-pre-run.ts",
    "audit:post-complete": "ts-node scripts/audit-post-complete.ts",
    "pipeline:run": "ts-node scripts/pipeline-orchestrator.ts",
    "pipeline:run:from": "ts-node scripts/pipeline-orchestrator.ts --from",
    "pipeline:status": "ts-node scripts/pipeline-orchestrator.ts --status",
    "fixme:scan": "ts-node scripts/scan-fixmes.ts",
    "registry:build": "ts-node scripts/build-test-id-registry.ts",
    "build:server": "tsc -p pipeline/tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('dist-pipeline/server/db',{recursive:true});fs.copyFileSync('pipeline/server/db/schema.sql','dist-pipeline/server/db/schema.sql')\"",
    "server:start": "ts-node pipeline/server/index.ts",
    "server:dev": "node --watch -r ts-node/register pipeline/server/index.ts",
    "worker:start": "ts-node pipeline/worker/index.ts",
    "db:migrate": "ts-node -e \"require('./pipeline/server/db/client').initializeSchema().then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "client:ship": "bash scripts/ship-client.sh",
    "check:tc-parity": "ts-node scripts/check-tc-parity.ts",
    "xlsx:build": "ts-node export_test_cases/to-xlsx.ts --list-only",
    "xlsx:build:with-run": "ts-node export_test_cases/to-xlsx.ts --with-run",
    "xlsx:build:with-run-json": "ts-node export_test_cases/to-xlsx.ts",
    "xlsx:build:list-only": "ts-node export_test_cases/to-xlsx.ts --list-only",
    "xlsx:freshness": "ts-node scripts/xlsx-freshness.ts",
    "xlsx:dump": "ts-node scripts/xlsx-dump.ts",
    "xlsx:lint": "node scripts/xlsx-vocab-lint.mjs",
    "test:humanize": "ts-node scripts/humanize.test.ts",
    "test:xlsx-sheet-name": "ts-node scripts/to-xlsx-sheet-name.test.ts",
    "test:xlsx-compose-reason": "ts-node scripts/xlsx-compose-reason.test.ts",
    "test:xlsx-continuation-row": "node scripts/xlsx-continuation-row.test.mjs",
    "test:xlsx-merged-shape": "node scripts/xlsx-merged-shape.test.mjs",
    "test:sp00-with-run": "ts-node scripts/sp00-with-run.test.ts",
    "test:sp00-fixme-path": "ts-node scripts/sp00-fixme-path.test.ts",
    "walk:enumerate": "node scripts/walk-coverage/enumerate-page.mjs",
    "walk:enumerate:test": "node scripts/walk-coverage/lib/test-enumerate-fixtures.mjs",
    "check:coverage-manifest": "node scripts/walk-coverage/lib/test-coverage-manifest.mjs",
    "walk:cross-check": "node scripts/walk-coverage/cross-check.mjs",
    "plans:reindex": "node scripts/plans-reindex.mjs",
    "plans:reindex:check": "node scripts/plans-reindex.mjs --check",
    "plans:validate-closure": "node scripts/validate-plan-closure.mjs --enforce --plan",
    "plans:validate-closure:write-manifest": "node scripts/validate-plan-closure.mjs --enforce --write-manifest --plan",
    "plans:validate-closure:retro": "node scripts/validate-plan-closure.mjs --all --report-only",
    "plans:validate-closure:changed": "node scripts/validate-plan-closure.mjs --changed --enforce",
    "plans:validate-closure:revalidate-all": "node scripts/validate-plan-closure.mjs --all --enforce --rewrite-manifests",
    "plans:validate-overrides": "node scripts/validate-overrides.mjs",
    "plans:validate-layout": "node scripts/validate-plan-layout.mjs --check",
    "plans:validate-layout:enforce-all": "node scripts/validate-plan-layout.mjs --enforce-all",
    "plans:validate-layout:cleanup-tmp": "node scripts/validate-plan-layout.mjs --cleanup-tmp-manifests",
    "plans:hooks:install": "git config core.hooksPath .githooks && echo \"hooks installed -> .githooks\"",
    "test:shared-paths": "node scripts/shared-paths.test.mjs",
    "verify:rules-fire": "node scripts/verify-rules-fire.mjs",
    "verify:protected-names": "node scripts/verify-protected-names.mjs",
    "verify:no-stale-refs": "node scripts/verify-no-stale-live-refs.mjs",
    "check:browsertool-parity": "node scripts/check-browsertool-parity.mjs",
    "check:lr-embed-parity": "node scripts/check-lr-embed-parity.mjs",
    "check:prune": "node scripts/prune-check.mjs",
    "check:per-test-baseline": "node scripts/check-per-test-baseline.mjs",
    "check:step-labels": "node scripts/check-step-labels.mjs --enforce",
    "check:spec-quality": "node scripts/check-unfailable-assertions.mjs --enforce && node scripts/check-swallowed-failures.mjs --enforce && node scripts/check-spec-sleeps.mjs --enforce && node scripts/check-reload-wait.mjs --enforce && node scripts/check-vacuous-grid-assertions.mjs && node scripts/check-reject-oracle.mjs && node scripts/check-doctrine-ledger.mjs",
    "check:doctrine-ledger": "node scripts/check-doctrine-ledger.mjs",
    "check:walk-observations": "node scripts/check-walk-observations.mjs",
    "check:untracked-knowledge": "node scripts/check-untracked-knowledge.mjs",
    "check:ramp-expiry": "node scripts/check-ramp-expiry.mjs",
    "check:enforcement-claims": "node scripts/check-enforcement-claims.mjs",
    "check:dispatch-argv": "node scripts/check-dispatch-argv.mjs",
    "check:fixture-provenance": "node scripts/walk-coverage/check-fixture-provenance.mjs",
    "test:spec-trim": "node scripts/spec-trim.test.mjs",
    "test:stale-live-refs": "node scripts/verify-no-stale-live-refs.test.mjs",
    "test:xlsx-camelcase-fn": "node scripts/xlsx-camelcase-fn.test.mjs",
    "test:shared-deps-gate": "node scripts/check-shared-deps.test.mjs",
    "test:step-labels-gate": "node --test scripts/check-step-labels.test.mjs",
    "check:step-label-parity": "node scripts/verify-step-label-parity.mjs",
    "test:todo-injection-fixtures": "node .claude/hooks/lib/test-todo-injection-fixtures.mjs",
    "selfclean": "node .claude/hooks/lib/selfclean/sweep.mjs",
    "selfclean:restore": "node .claude/hooks/lib/selfclean/sweep.mjs --restore",
    "selfclean:gc": "node .claude/hooks/lib/selfclean/sweep.mjs --gc",
    "selfclean:status": "node .claude/hooks/lib/selfclean/sweep.mjs --status",
    "prepare": "npm run plans:hooks:install"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "page-object-model",
    "e2e"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.18.0",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.7.0",
    "eslint": "^8.54.0",
    "exceljs": "^4.4.0",
    "gpt-tokenizer": "^3.4.0",
    "jest": "^30.3.0",
    "minimatch": "9.0.3",
    "prettier": "^3.1.0",
    "proper-lockfile": "^4.1.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.984.0",
    "@fastify/cors": "^10.1.0",
    "axios": "^1.13.4",
    "dotenv-flow": "^4.1.0",
    "fastify": "^5.8.2",
    "knex": "^3.1.0",
    "pg": "^8.18.0",
    "pino-pretty": "^13.1.3",
    "playwright": "1.60.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
