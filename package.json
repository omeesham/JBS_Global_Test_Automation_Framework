{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "description": "Playwright TypeScript automation framework with Page Object Model",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist/"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rimraf dist && tsc -p tsconfig.build.json",
    "client:package": "ts-node scripts/client-package.ts",
    "pretest": "ts-node scripts/cleanup-logs.ts",
    "test": "playwright test --config=playwright.config.ts",
    "test:headed": "playwright test --config=playwright.config.ts --headed",
    "test:chrome": "playwright test --config=playwright.config.ts --project=chrome",
    "test:firefox": "playwright test --config=playwright.config.ts --project=firefox",
    "test:webkit": "playwright test --config=playwright.config.ts --project=webkit",
    "test:debug": "playwright test --config=playwright.config.ts --debug",
    "test:ui": "playwright test --config=playwright.config.ts --ui",
    "test:adapters": "playwright test --config=playwright.config.ts \"src/data/adapters/__tests__/**/*.spec.ts\"",
    "report": "playwright show-report",
    "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "setup": "npm install && npx playwright install",
    "setup:browsers": "npx playwright install chromium firefox webkit",
    "clean": "rimraf reports/* logs/*",
    "clean:root": "ts-node scripts/clean-root.ts",
    "clean:artifacts": "ts-node scripts/clean-artifacts.ts",
    "cleanup:logs": "ts-node scripts/cleanup-logs.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "upload:sharepoint": "ts-node scripts/upload-to-sharepoint.ts",
    "vault:init": "ts-node scripts/vault-manager.ts init",
    "vault:set": "ts-node scripts/vault-manager.ts set",
    "vault:get": "ts-node scripts/vault-manager.ts get",
    "vault:list": "ts-node scripts/vault-manager.ts list",
    "vault:delete": "ts-node scripts/vault-manager.ts delete",
    "vault:rotate": "ts-node scripts/vault-manager.ts rotate",
    "vault:info": "ts-node scripts/vault-manager.ts info",
    "export:csv": "ts-node export_test_cases/to-csv.ts",
    "export:csv:human": "ts-node export_test_cases/to-csv.ts ./specs_planning/test-cases ./exports/test-cases-human.csv --type=human",
    "export:csv:agent": "ts-node export_test_cases/to-csv.ts ./specs_planning/test-cases ./exports/test-cases-agent.csv --type=agent",
    "export:csv:full": "ts-node export_test_cases/to-csv.ts ./specs_planning/test-cases ./exports/test-cases-full.csv --type=full",
    "lint:testcases": "ts-node scripts/lint-test-cases.ts",
    "sync:mistakes": "ts-node scripts/sync-agent-mistakes.ts",
    "sync:mistakes:dry": "ts-node scripts/sync-agent-mistakes.ts --dry-run",
    "validate:sync": "ts-node scripts/validate-agent-sync.ts",
    "build:context": "ts-node scripts/task-context-builder.ts",
    "build:context:json": "ts-node scripts/task-context-builder.ts --json",
    "metrics:agents": "ts-node scripts/agent-metrics.ts",
    "metrics:agents:json": "ts-node scripts/agent-metrics.ts --json",
    "metrics:update-trust": "ts-node scripts/agent-metrics.ts --update-trust",
    "planner:post-complete": "ts-node scripts/planner-post-complete.ts",
    "planner:export-all": "ts-node scripts/planner-post-complete.ts --all",
    "pipeline:validate": "npm run validate:sync && npm run queue:validate && npm run lint:testcases && npm run detect:duplication",
    "pipeline:preflight": "npm run validate:sync && npm run build:context && npm run lint:testcases",
    "queue:archive": "ts-node scripts/archive-queue.ts",
    "queue:archive:dry": "ts-node scripts/archive-queue.ts --dry-run",
    "queue:compact": "ts-node scripts/archive-queue.ts --compact",
    "queue:validate": "ts-node scripts/validate-queue-integrity.ts",
    "detect:duplication": "ts-node scripts/detect-duplication.ts",
    "generator:post-complete": "ts-node scripts/generator-post-complete.ts",
    "generator:validate-selectors": "ts-node scripts/generator-validate-selectors.ts",
    "generator:pre-run": "ts-node scripts/generator-pre-run.ts",
    "selectors:catalog": "npx ts-node scripts/generate-selector-catalog.ts",
    "test:failed": "npx playwright test --config=playwright.config.ts --last-failed",
    "test:grep": "npx playwright test --config=playwright.config.ts --grep",
    "test:spec-grep": "npx playwright test --config=playwright.config.ts",
    "fixme:scan": "ts-node scripts/scan-fixmes.ts",
    "registry:build": "ts-node scripts/build-test-id-registry.ts"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "page-object-model",
    "e2e"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "allure-commandline": "^2.25.0",
    "allure-playwright": "2.15.1",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.984.0",
    "axios": "^1.13.4",
    "dotenv-flow": "^4.1.0",
    "knex": "^3.1.0",
    "otplib": "^12.0.1",
    "pg": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
