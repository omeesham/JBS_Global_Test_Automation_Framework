{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "description": "Playwright TypeScript automation framework with Page Object Model",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "npm test --prefix clients/encore",
    "test:adapters": "playwright test --config=playwright.config.framework.ts",
    "report": "playwright show-report reports/html-report",
    "allure:archive": "node scripts/archive-allure.js",
    "allure:generate": "npx allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:history": "node scripts/preserve-allure-history.js && npm run allure:report",
    "allure:open": "npx allure open reports/allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "html:archive": "node scripts/archive-html.js",
    "reports:archive": "npm run allure:archive && npm run html:archive",
    "reports:clean": "node scripts/ensure-report-dirs.js && npm run clean:results",
    "test:daily": "npm run test:daily --prefix clients/encore",
    "clean:results": "node -e \"const fs=require('fs'),p='reports/allure-results',keep=new Set(['categories.json','environment.properties','history']);fs.readdirSync(p).filter(f=>!keep.has(f)).forEach(f=>fs.unlinkSync(p+'/'+f));console.log('[OK] allure-results cleaned (config + history preserved)')\"",
    "test:clean": "npm run clean:results && npm test",
    "audit:block": "ts-node scripts/audit-block.ts",
    "setup": "npm install && npx playwright install",
    "setup:browsers": "npx playwright install chromium firefox webkit",
    "clean": "rimraf reports/allure-results reports/allure-report reports/diagnostics reports/walkthrough reports/html-report reports/test-results reports/test-results.json reports/failure-summary.json reports/junit-results.xml reports/preflight-check.json reports/fixme-registry.json reports/quality-report.pdf logs/test-execution.log && node scripts/ensure-report-dirs.js",
    "clean:reports": "rimraf reports/html-report reports/allure-results reports/allure-report reports/test-results reports/test-results.json reports/failure-summary.json reports/junit-results.xml && node scripts/ensure-report-dirs.js",
    "clean:root": "ts-node scripts/clean-root.ts",
    "clean:artifacts": "ts-node scripts/clean-artifacts.ts",
    "cleanup:logs": "ts-node scripts/cleanup-logs.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "lint:testcases": "ts-node scripts/lint-test-cases.ts",
    "sync:mistakes": "ts-node scripts/sync-agent-mistakes.ts",
    "sync:mistakes:dry": "ts-node scripts/sync-agent-mistakes.ts --dry-run",
    "capture:mistake": "ts-node scripts/capture-mistake.ts",
    "validate:sync": "ts-node scripts/validate-agent-sync.ts",
    "validate:activity-log": "node scripts/validate-activity-log.mjs",
    "validate:activity-log:preflight": "node scripts/validate-activity-log.mjs --latest-per-file --recent=5",
    "validate:tc-has-fieldinventory": "node scripts/check-tc-has-fieldinventory.mjs",
    "test:tc-has-fieldinventory": "node scripts/check-tc-has-fieldinventory.test.mjs",
    "validate:tc-mcp-citations": "node scripts/check-tc-mcp-citations.mjs",
    "test:tc-mcp-citations": "node scripts/check-tc-mcp-citations.test.mjs",
    "validate:fieldinventory-staleness": "node scripts/check-fieldinventory-staleness.mjs",
    "test:fieldinventory-staleness": "node scripts/check-fieldinventory-staleness.test.mjs",
    "build:context": "ts-node scripts/task-context-builder.ts",
    "build:context:json": "ts-node scripts/task-context-builder.ts --json",
    "metrics:agents": "ts-node scripts/agent-metrics.ts",
    "metrics:agents:json": "ts-node scripts/agent-metrics.ts --json",
    "metrics:update-trust": "ts-node scripts/agent-metrics.ts --update-trust",
    "planner:post-complete": "ts-node scripts/planner-post-complete.ts",
    "planner:export-all": "ts-node scripts/planner-post-complete.ts --all",
    "pipeline:validate": "npm run validate:sync && npm run queue:validate && npm run lint:testcases && npm run detect:duplication",
    "pipeline:preflight": "npm run validate:sync && npm run build:context && npm run lint:testcases && npm run validate:activity-log:preflight",
    "queue:archive": "ts-node scripts/archive-queue.ts",
    "queue:archive:dry": "ts-node scripts/archive-queue.ts --dry-run",
    "queue:compact": "ts-node scripts/archive-queue.ts --compact",
    "queue:validate": "ts-node scripts/validate-queue-integrity.ts",
    "detect:duplication": "ts-node scripts/detect-duplication.ts",
    "generator:post-complete": "ts-node scripts/generator-post-complete.ts",
    "generator:validate-selectors": "ts-node scripts/generator-validate-selectors.ts",
    "generator:pre-run": "ts-node scripts/generator-pre-run.ts",
    "selectors:catalog": "npx ts-node scripts/generate-selector-catalog.ts",
    "requirements:pre-run": "ts-node scripts/requirements-pre-run.ts",
    "requirements:post-complete": "ts-node scripts/requirements-post-complete.ts",
    "healer:pre-run": "ts-node scripts/healer-pre-run.ts",
    "healer:post-complete": "ts-node scripts/healer-post-complete.ts",
    "audit:pre-run": "ts-node scripts/audit-pre-run.ts",
    "audit:post-complete": "ts-node scripts/audit-post-complete.ts",
    "pipeline:run": "ts-node scripts/pipeline-orchestrator.ts",
    "pipeline:run:from": "ts-node scripts/pipeline-orchestrator.ts --from",
    "pipeline:status": "ts-node scripts/pipeline-orchestrator.ts --status",
    "fixme:scan": "ts-node scripts/scan-fixmes.ts",
    "registry:build": "ts-node scripts/build-test-id-registry.ts",
    "build:server": "tsc -p pipeline/tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('dist-pipeline/server/db',{recursive:true});fs.copyFileSync('pipeline/server/db/schema.sql','dist-pipeline/server/db/schema.sql')\"",
    "server:start": "ts-node pipeline/server/index.ts",
    "server:dev": "node --watch -r ts-node/register pipeline/server/index.ts",
    "worker:start": "ts-node pipeline/worker/index.ts",
    "db:migrate": "ts-node -e \"require('./pipeline/server/db/client').initializeSchema().then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "vendor:build": "ts-node scripts/build-framework-vendor.ts",
    "vendor:build:all": "node scripts/build-framework-vendor-all.mjs",
    "client:ship": "bash scripts/ship-client.sh",
    "check:tc-parity": "ts-node scripts/check-tc-parity.ts",
    "check:tc-parity:fix": "ts-node scripts/check-tc-parity.ts --fix-csv",
    "plans:reindex": "node scripts/plans-reindex.mjs",
    "plans:reindex:check": "node scripts/plans-reindex.mjs --check",
    "plans:hooks:install": "git config core.hooksPath .githooks && echo \"hooks installed -> .githooks\"",
    "test:shared-paths": "node scripts/shared-paths.test.mjs",
    "check:browsertool-parity": "node scripts/check-browsertool-parity.mjs"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "page-object-model",
    "e2e"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.18.0",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.7.0",
    "eslint": "^8.54.0",
    "exceljs": "^4.4.0",
    "gpt-tokenizer": "^3.4.0",
    "jest": "^30.3.0",
    "prettier": "^3.1.0",
    "proper-lockfile": "^4.1.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.984.0",
    "@fastify/cors": "^10.1.0",
    "axios": "^1.13.4",
    "dotenv-flow": "^4.1.0",
    "fastify": "^5.8.2",
    "knex": "^3.1.0",
    "pg": "^8.18.0",
    "pino-pretty": "^13.1.3",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
