// Jenkinsfile for Ubuntu
// Jenkins Pipeline for Playwright Tests on Ubuntu/Linux

pipeline {
    agent {
        label 'ubuntu'
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'production'], description: 'Environment to run tests against')
        choice(name: 'BROWSER', choices: ['chrome', 'chromium', 'firefox', 'webkit', 'all'], description: 'Browser to run tests')
        booleanParam(name: 'PARALLEL', defaultValue: true, description: 'Run tests in parallel')
        booleanParam(name: 'UPLOAD_TO_SHAREPOINT', defaultValue: false, description: 'Upload downloads to SharePoint after tests')
    }

    environment {
        NODE_ENV = "${params.ENVIRONMENT}"
        PLAYWRIGHT_BROWSERS_PATH = "${WORKSPACE}/ms-playwright"
        CI = "true"

        // ==================== GIT TIMEOUT FIX (OPTIONAL - USER CONFIG) ====================
        // Uncomment these if allure-playwright is re-enabled in CI config:
        // ALLURE_RESULTS_WITHOUT_GIT = "true"  // Skip git info collection
        // GIT_COMMAND_TIMEOUT = "10000"         // 10 second timeout for git commands
    }

    stages {
        stage('Checkout') {
            steps {
                // FLEXIBLE CHECKOUT: Supports both SCM (production) and local testing
                script {
                    try {
                        checkout scm
                        echo "✓ Checked out from SCM (Git repository)"
                    } catch (Exception e) {
                        echo "⚠ SCM checkout skipped (local testing mode)"
                        echo "Using existing workspace files from: ${WORKSPACE}"
                    }
                }

                // Display build info (works with or without Git)
                sh '.ci/git-info.sh'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'node --version'
                sh 'npm --version'
                sh 'npm clean-install'
            }
        }

        stage('Install Playwright Browsers') {
            steps {
                sh 'npx playwright install --with-deps'
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    def browser = params.BROWSER == 'all' ? '' : "--project=${params.BROWSER}"

                    // Uses playwright.config.ci.ts (no allure-playwright, avoids git timeout)
                    sh """
                        export NODE_ENV=${params.ENVIRONMENT}
                        npx playwright test --config=playwright.config.ci.ts ${browser}
                    """
                }
            }
        }

        // ==================== ALLURE REPORT DISABLED (Git Timeout Fix) ====================
        // allure-playwright removed from CI config (playwright.config.ci.ts) to fix GitCommitInfo timeout
        // Uncomment this stage if you re-enable allure-playwright with ALLURE_RESULTS_WITHOUT_GIT=true
        //
        // stage('Generate Allure Report') {
        //     steps {
        //         sh 'npx allure generate reports/allure-results --clean -o reports/allure-report'
        //     }
        // }

        stage('Upload to SharePoint') {
            when {
                allOf {
                    expression { params.UPLOAD_TO_SHAREPOINT == true }
                    expression { fileExists('tests/test-data/downloads') }
                }
            }
            steps {
                sh 'npx ts-node scripts/upload-to-sharepoint.ts --dir=tests/test-data/downloads'
            }
        }
    }

    post {
        always {
            // Publish test results
            junit 'reports/junit-results.xml'

            // Publish HTML report
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'reports/html-report',
                reportFiles: 'index.html',
                reportName: 'Playwright HTML Report'
            ])

            // Publish Allure report (DISABLED - Git Timeout Fix)
            // Uncomment if you re-enable allure-playwright with ALLURE_RESULTS_WITHOUT_GIT=true
            // allure([
            //     includeProperties: false,
            //     jdk: '',
            //     properties: [],
            //     reportBuildPolicy: 'ALWAYS',
            //     results: [[path: 'reports/allure-results']]
            // ])

            // Archive artifacts
            archiveArtifacts artifacts: 'reports/**/*,tests/test-data/downloads/**/*', allowEmptyArchive: true

            // Clean workspace
            cleanWs()
        }

        success {
            echo "Tests passed successfully!"
        }

        failure {
            emailext(
                subject: "Test Failure: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """<h2>Test Execution Failed</h2>
                <p><strong>Environment:</strong> ${params.ENVIRONMENT}</p>
                <p><strong>Browser:</strong> ${params.BROWSER}</p>
                <p><strong>Build URL:</strong> <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
                """,
                mimeType: 'text/html',
                recipientProviders: [developers(), requestor()]
            )
        }
    }
}
