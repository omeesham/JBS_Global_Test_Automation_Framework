// Jenkinsfile for Windows (Pipeline Script - paste into Jenkins UI)
// IMPORTANT: Every npm/npx command MUST use "call" prefix in Windows batch.
// Without "call", npm.cmd takes over and the parent batch script exits silently.

pipeline {
    agent { label 'built-in' }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['development', 'staging', 'production'], description: 'Target environment')
        choice(name: 'BROWSER', choices: ['chromium', 'chrome', 'firefox', 'webkit'], description: 'Browser to run tests')
        string(name: 'TEST_PATTERN', defaultValue: '', description: 'Specific test grep pattern (empty = all tests)')
        booleanParam(name: 'ENABLE_VIDEO', defaultValue: true, description: 'Record test videos')
        booleanParam(name: 'ENABLE_TRACING', defaultValue: true, description: 'Capture Playwright traces')
        booleanParam(name: 'ENABLE_SCREENSHOTS', defaultValue: true, description: 'Capture screenshots on failure')
        booleanParam(name: 'HEADED', defaultValue: false, description: 'Run with visible browser (local debug only)')
    }

    environment {
        PROJECT_SRC = "C:\\Users\\rutvi\\projects\\encore_framework"
        CI = "true"
        CI_ENV = "${params.ENVIRONMENT}"
        PLAYWRIGHT_BROWSERS_PATH = "${WORKSPACE}\\.browsers"
        ENABLE_VIDEO = "${params.ENABLE_VIDEO}"
        ENABLE_TRACING = "${params.ENABLE_TRACING}"
        ENABLE_SCREENSHOTS = "${params.ENABLE_SCREENSHOTS}"
    }

    stages {
        stage('Kill Old Processes') {
            steps {
                bat '''
                    taskkill /f /im node.exe /t 2>nul || exit /b 0
                    taskkill /f /im chrome-headless-shell.exe /t 2>nul || exit /b 0
                    taskkill /f /im chrome.exe /t 2>nul || exit /b 0
                    taskkill /f /im firefox.exe /t 2>nul || exit /b 0
                    echo Processes cleaned
                '''
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                    echo Cleaning workspace...
                    for /d %%i in (*) do rmdir /s /q "%%i" 2>nul || echo Skipped %%i
                    del /f /q * 2>nul || echo Cleaned files
                '''
            }
        }

        stage('Copy Framework') {
            steps {
                bat '''
                    echo Copying from %PROJECT_SRC%
                    robocopy "%PROJECT_SRC%" "%WORKSPACE%" /E /XD node_modules ms-playwright reports logs .git .browsers /XF .env.local /NFL /NDL /NJH /NJS /nc /ns /np || exit /b 0
                    if exist "%WORKSPACE%\\package.json" (
                        echo Framework copied successfully
                    ) else (
                        echo ERROR: package.json not found after copy!
                        exit /b 1
                    )
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                bat '''
                    echo ========================================
                    echo STAGE: Install Dependencies
                    echo ========================================

                    call node --version
                    call npm --version

                    echo Checking for package.json...
                    if not exist package.json (
                        echo ERROR: package.json not found!
                        exit /b 1
                    )
                    echo Found package.json

                    if exist package-lock.json (
                        echo Found package-lock.json - using npm ci
                        call npm ci --no-audit --prefer-offline
                    ) else (
                        echo No package-lock.json - using npm install
                        call npm install --no-audit
                    )

                    if errorlevel 1 (
                        echo ERROR: npm install failed!
                        exit /b 1
                    )

                    if not exist node_modules (
                        echo ERROR: node_modules was not created!
                        exit /b 1
                    )

                    if not exist "node_modules\\@playwright\\test" (
                        echo ERROR: @playwright/test not installed!
                        exit /b 1
                    )

                    echo SUCCESS: Dependencies installed
                    echo ========================================
                '''
            }
        }

        stage('Install Playwright Browsers') {
            steps {
                bat '''
                    echo Installing %BROWSER% browser with dependencies...
                    call npx playwright install %BROWSER% --with-deps

                    if errorlevel 1 (
                        echo ERROR: Browser installation failed
                        exit /b 1
                    )

                    call npx playwright --version
                    if errorlevel 1 (
                        echo ERROR: Playwright not found after install!
                        exit /b 1
                    )

                    echo Browser installed successfully
                '''
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    def headedFlag = params.HEADED ? '--headed' : ''
                    def grepFlag = params.TEST_PATTERN ? "--grep=\"${params.TEST_PATTERN}\"" : ''

                    bat """
                        set PLAYWRIGHT_BROWSERS_PATH=%WORKSPACE%\\.browsers
                        set CI=true
                        set CI_ENV=${params.ENVIRONMENT}
                        set ENABLE_VIDEO=${params.ENABLE_VIDEO}
                        set ENABLE_TRACING=${params.ENABLE_TRACING}
                        set ENABLE_SCREENSHOTS=${params.ENABLE_SCREENSHOTS}

                        echo Running Playwright tests...
                        echo Browser: ${params.BROWSER}
                        echo Pattern: ${params.TEST_PATTERN ?: 'ALL TESTS'}

                        call npx playwright test tests/specs/navigator --config=playwright.config.ci.ts --project=${params.BROWSER} ${headedFlag} ${grepFlag}
                    """
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'reports/junit-results.xml'

            publishHTML([
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'reports/html-report',
                reportFiles: 'index.html',
                reportName: 'Playwright Test Report'
            ])

            // Debug visibility: list files before archiving
            bat 'dir /s reports\\test-results\\ 2>nul || echo No test results'
            bat 'dir /s logs\\ 2>nul || echo No logs'
            bat 'dir /s tests\\test-data\\downloads\\ 2>nul || echo No downloads'

            archiveArtifacts artifacts: 'reports/**,logs/**,tests/test-data/downloads/**', allowEmptyArchive: true
            archiveArtifacts artifacts: 'reports/test-results/**/*.zip', allowEmptyArchive: true
        }

        success {
            echo "Tests passed on ${params.BROWSER} in ${params.ENVIRONMENT} environment!"
        }

        failure {
            echo "Tests failed - check artifacts for debugging"
        }

        cleanup {
            bat 'taskkill /f /im node.exe /t 2>nul || exit /b 0'
        }
    }
}
